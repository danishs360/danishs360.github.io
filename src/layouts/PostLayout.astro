---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Image } from "astro:assets";
import { SITE_URL, SITE_AUTHOR } from "../config";
import { PERSON_ID } from "../lib/schema";

export interface Props extends BlogSchema {}

const { title, description, pubDate, updatedDate, heroImage, badge, tags = [] } = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
const publishedISO = pubDate.toISOString();
const modifiedISO = updatedDate ? new Date(updatedDate).toISOString() : publishedISO;
const articleUrl = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const imageUrl = heroImage ? new URL(heroImage, Astro.site ?? SITE_URL).href : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  url: articleUrl,
  author: { "@type": "Person", "@id": PERSON_ID, name: SITE_AUTHOR, url: `${SITE_URL}/` },
  publisher: { "@id": PERSON_ID },
  mainEntityOfPage: articleUrl,
  ...(imageUrl && { image: imageUrl }),
};
---

<BaseLayout
  title={`${title} · Danish Siddique`}
  description={description}
  image={heroImage}
  ogType="article"
  wide
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
>
  <JsonLd schema={articleSchema} />
  <article class="max-w-2xl mx-auto">
    {heroImage && (
      <Image
        width={900}
        height={420}
        format="webp"
        src={heroImage}
        alt={title}
        class="w-full mb-8 max-h-[380px] object-cover rounded-[10px] border-[6px] border-white shadow-print -rotate-[0.6deg]"
      />
    )}
    <header class="mb-10">
      <time datetime={publishedISO} class="hand text-ember-ink text-lg inline-block -rotate-2">
        {displayDate}
      </time>
      <h1 class="display-title text-4xl sm:text-5xl mt-3 mb-4">{title}</h1>
      {description && <p class="text-lg text-ink-dim leading-relaxed">{description}</p>}
      <div class="flex flex-wrap gap-2 mt-4">
        {badge && <span class="tag-pill !bg-note-butter !border-transparent">{badge}</span>}
        {
          tags?.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="tag-pill hover:!border-ink-muted no-underline">
              {tag}
            </a>
          ))
        }
      </div>
      {updatedDate && (
        <p class="text-xs text-ink-muted mt-3">Last updated {updatedDate}</p>
      )}
    </header>
    <div class="prose-signal prose-lg">
      <slot />
    </div>
    <div class="mt-16 pt-8 border-t border-ink-line text-center">
      <a href="/blog/" class="btn-ghost-line !text-sm">← Back to writing</a>
    </div>
  </article>
</BaseLayout>
