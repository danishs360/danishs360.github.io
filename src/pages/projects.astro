---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Projects</div>
  </div>

  <HorizontalCard
    title="Mynd — AI Practice Management for Therapists"
    img="/post_img.webp"
    desc="End-to-end SaaS platform powering 200+ therapists. Video sessions, automated note-taking with GPT/Gemini, RAG-based clinical chat, multi-agent workflow automation with LangChain + Inngest, scheduling, billing. Built on Node.js (TypeScript), Django, AWS Lambda, React, Chakra UI, and Tailwind."
    url="https://mynd.app"
    badge="CURRENT"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="RAG-Powered Customer Support Chatbot (Extendly)"
    img="/post_img.webp"
    desc="Contextual customer support chatbot built with OpenAI, FastAPI, and PostgreSQL. Improved response accuracy and significantly reduced manual support load by retrieving and grounding answers in customer-specific docs."
    url="#"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Medimap"
    img="/post_img.webp"
    desc="Healthcare platform helping patients find nearby walk-in clinics, urgent care centers, and other healthcare providers in real time."
    url="https://medimap.ca/"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="KindlMedia Chat System"
    img="/post_img.webp"
    desc="Custom real-time chat system supporting direct communication between clients and businesses, with reliable delivery and live presence."
    url="https://kb.mycrmsupport.com/kindlmedia1"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Trademark Infringement Detection (Zaytrics)"
    img="/post_img.webp"
    desc="ML-based logo similarity system for detecting trademark infringement, reaching 85%+ accuracy and cutting manual review by ~70%."
    url="#"
  />
</BaseLayout>
