---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductPin from "../components/ProductPin.astro";
import Wiring from "../components/Wiring.astro";
import { PAGE_SEO } from "../config";
import {
  tallyreel,
  roundZero,
  sideProjects,
  kindredCore,
  agentOps,
  kindredWorkplace,
  kindredPractice,
  moreKindred,
  wirings,
} from "../data/work";

const wire = (id: string) => wirings.find((w) => w.id === id)!;

const studio = [
  { product: tallyreel, wiring: wire("tallyreel") },
  { product: roundZero, wiring: wire("roundzero") },
];

const kindred = [
  { product: kindredWorkplace, wiring: wire("workplace") },
  { product: kindredPractice, wiring: wire("practice") },
  { product: kindredCore, wiring: wire("core") },
  { product: agentOps, wiring: wire("agentops") },
];

const earlier = [
  { name: "Support assistant · Extendly", body: "Retrieval-backed assistant on OpenAI, FastAPI and PostgreSQL that answered 500–600 support tickets a day from the product knowledge base." },
  { name: "GoHighLevel sync · Extendly", body: "Customer-facing React apps and a serverless AWS Lambda layer that syncs GoHighLevel with third-party tools, so nobody copies records by hand." },
  { name: "Trademark infringement detection · Zaytrics", body: "Computer-vision system that spots infringing logos at 85%+ accuracy, removing roughly 70% of the legal team's manual review." },
  { name: "Liver tumor segmentation", body: "Final-year research: deep-learning segmentation of the liver and liver tumors in abdominal CT scans." },
];
---

<BaseLayout
  title={PAGE_SEO.projects.title}
  description={PAGE_SEO.projects.description}
  sideBarActiveItemID="projects"
  crumb="Projects"
  wide
>
  <header class="max-w-3xl">
    <p class="hand text-ember-ink text-lg -rotate-2 inline-block mb-3">the whole wall</p>
    <h1 class="display-title text-[clamp(40px,5.4vw,64px)]">What I've built, and what it did</h1>
    <p class="mt-5 text-lg text-ink-dim">
      What each product does for the people using it, what I built, and a simple picture of how it works. Kindred AI
      products are built with a team of product, design and engineering colleagues, and I say which parts I owned.
      The side projects are things I build outside work.
    </p>
    <nav class="flex flex-wrap gap-2 mt-7" aria-label="Sections">
      <a href="#kindred" class="tag-pill no-underline hover:border-ink-muted">Kindred AI</a>
      <a href="#studio" class="tag-pill no-underline hover:border-ink-muted">Side projects</a>
      <a href="#earlier" class="tag-pill no-underline hover:border-ink-muted">Earlier</a>
    </nav>
  </header>

  <!-- ═══ KINDRED ═══ -->
  <section id="kindred" class="pt-24" aria-labelledby="kindred-h">
    <h2 id="kindred-h" class="display-title text-[clamp(30px,3.8vw,44px)]">Kindred AI</h2>
    <p class="mt-3 text-ink-dim text-lg max-w-2xl">
      Senior Product Engineer since September 2023, working remotely. Kindred Workplace and Kindred Practice are
      the products I've spent most of my time on; Kindred Core and Agent Ops are the shared AI and tooling
      underneath them, and I've also delivered Medimap and the Stellantis Skills Platform.
    </p>

    {
      kindred.map(({ product, wiring }, i) => (
        <div class="pt-20">
          <ProductPin product={product} flip={i % 2 === 1} detail />
          {wiring && (
            <div class="mt-14">
              <Wiring wiring={wiring} />
            </div>
          )}
        </div>
      ))
    }

    <div class="grid md:grid-cols-2 gap-4 mt-20">
      {
        moreKindred.map((m) => (
          <article class="bento-card p-6">
            <h3 class="text-lg font-extrabold tracking-[-0.01em]">{m.name}</h3>
            <p class="mt-2 text-[15px] text-ink-dim leading-relaxed">{m.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══ SOONBUILT ═══ -->
  <section id="studio" class="pt-32" aria-labelledby="studio-h">
    <div class="flex items-center gap-3 mb-4">
      <svg viewBox="0 0 40 40" class="w-7 h-7 text-ember-bright" aria-hidden="true"
        ><path fill="currentColor" d="M4 13a9 9 0 0 1 9-9h7v16h16v7a9 9 0 0 1-9 9H13a9 9 0 0 1-9-9z"></path><rect
          x="24"
          y="4"
          width="12"
          height="12"
          rx="4"
          fill="currentColor"></rect></svg
      >
      <h2 id="studio-h" class="display-title text-[clamp(30px,3.8vw,44px)]">Side projects</h2>
    </div>
    <p class="text-ink-dim text-lg max-w-2xl">
      Independent products I design, build and launch outside my day job, under the Soonbuilt name.
    </p>

    {
      studio.map(({ product, wiring }, i) => (
        <div class="pt-20">
          <ProductPin product={product} flip={i % 2 === 1} detail />
          {wiring && (
            <div class="mt-14">
              <Wiring wiring={wiring} />
            </div>
          )}
        </div>
      ))
    }

    <div class="grid sm:grid-cols-2 gap-10 mt-20">
      <figure class="print" style="transform: rotate(-1deg)">
        <span class="tape" aria-hidden="true"></span>
        <div class="print-frame !bg-white aspect-[16/10]">
          <img src="/media/soonbuilt/tallyreel-studio-script.webp" alt="TallyReel shows the script it wrote, with one line edited, before anything renders" loading="lazy" class="object-top" />
        </div>
        <figcaption>You read and edit the script before anything renders.</figcaption>
      </figure>
      <figure class="print" style="transform: rotate(1deg)">
        <span class="tape" aria-hidden="true"></span>
        <div class="print-frame !bg-white aspect-[16/10]">
          <img src="/media/soonbuilt/tallyreel-post.webp" alt="TallyReel Post: a week board of scheduled videos" loading="lazy" class="object-top" />
        </div>
        <figcaption>Post: pin a video to the week and it goes out on its own.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ MORE SIDE PROJECTS ═══ -->
  <section id="more-side-projects" class="pt-32" aria-labelledby="bench-h">
    <div class="relative max-w-2xl">
      <h2 id="bench-h" class="display-title text-[clamp(30px,3.8vw,44px)]">Smaller side projects</h2>
      <p class="mt-3 text-ink-dim text-lg">Two more independent products, both live.</p>
    </div>
    <div class="grid sm:grid-cols-2 gap-8 mt-12">
      {
        sideProjects.map((w, i) => (
          <article class={`note note-${w.tint} !p-6`} style={`--tilt:${[-1.5, 1.2][i]}deg`}>
            <span class="tape" aria-hidden="true" />
            <span class="note-tag">Live</span>
            <h3 class="note-idea !text-[22px]">{w.name}</h3>
            <p class="text-[15px] leading-relaxed text-[rgba(28,25,23,.78)]">{w.body}</p>
            <a href={w.url} target="_blank" rel="noopener" class="mt-auto pt-2 text-[13px] font-semibold text-[rgba(28,25,23,.7)]">
              {w.urlText} ↗
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══ EARLIER ═══ -->
  <section id="earlier" class="pt-32" aria-labelledby="earlier-h">
    <h2 id="earlier-h" class="display-title text-[clamp(30px,3.8vw,44px)]">Earlier</h2>
    <p class="mt-3 text-ink-dim text-lg max-w-2xl">Work from Extendly, Zaytrics and university.</p>
    <ul class="sheet list-none m-0 mt-10 p-4 sm:p-6 grid sm:grid-cols-2 gap-x-10">
      {
        earlier.map((e) => (
          <li class="py-4 border-b border-ink-line">
            {e.url ? (
              <a href={e.url} target="_blank" rel="noopener" class="font-bold text-ink-text no-underline hover:text-ember-ink">
                {e.name} ↗
              </a>
            ) : (
              <span class="font-bold">{e.name}</span>
            )}
            <p class="text-[15px] text-ink-dim mt-1">{e.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
