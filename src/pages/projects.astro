---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductPin from "../components/ProductPin.astro";
import Wiring from "../components/Wiring.astro";
import { PAGE_SEO } from "../config";
import {
  tallyreel,
  roundZero,
  soonbuilt,
  kindredCore,
  kindredMemory,
  agentOps,
  kindredWorkplace,
  kindredPractice,
  moreKindred,
  wirings,
  type Tint,
} from "../data/work";

const wire = (id: string) => wirings.find((w) => w.id === id)!;

const studio = [
  { product: tallyreel, wiring: wire("tallyreel") },
  { product: roundZero, wiring: wire("roundzero") },
  { product: soonbuilt, wiring: wire("soonbuilt") },
];

const kindred = [
  { product: kindredCore, wiring: wire("core") },
  { product: kindredMemory, wiring: wire("memory") },
  { product: agentOps, wiring: wire("agentops") },
];

const workbench: { name: string; body: string; stack: string; tint: Tint; status: string }[] = [
  {
    name: "voice-lab",
    body: "Voice cloning on an Apple-silicon Mac in English, Hindi and Urdu, no API keys. Urdu is transliterated to Devanagari so the Hindi voice can speak it. The research behind TallyReel's cloned voices.",
    stack: "Python · Chatterbox · pyloudnorm · ffmpeg",
    tint: "peach",
    status: "Prototype",
  },
  {
    name: "ClauseGuard",
    body: "Contract review for freelancers. Flags risky clauses and missing ones, explains them plainly and suggests redlines. Output held to a strict schema, with precision and recall evals per clause type.",
    stack: "Fastify · React · Zod · evals",
    tint: "butter",
    status: "Building",
  },
  {
    name: "DropChat",
    body: "Chat with your docs from one script tag. Crawl, chunk and embed into pgvector; a Shadow-DOM widget streams cited answers over SSE.",
    stack: "pgvector · SSE · vanilla JS",
    tint: "mint",
    status: "Building",
  },
  {
    name: "mcp-prod",
    body: "A production template for MCP servers in TypeScript: stdio and Streamable HTTP from one codebase, pluggable storage, tests and CI.",
    stack: "TypeScript · MCP · Postgres · Vitest",
    tint: "sky",
    status: "Open source",
  },
  {
    name: "voice-agent-saas",
    body: "A deploy-anywhere starter for voice agents: LiveKit Agents, Deepgram and Silero turn detection, with transcripts in Postgres. The seed of Round Zero's voice loop.",
    stack: "LiveKit · Deepgram · Postgres",
    tint: "lilac",
    status: "Open source",
  },
];

const earlier = [
  { name: "Medimap", body: "Find nearby walk-in clinics and urgent care in real time.", url: "https://medimap.ca/", img: "/projects/medimap.png" },
  { name: "RAG support chatbot · Extendly", body: "Customer-support bot grounded in each customer's own docs. OpenAI, FastAPI, Postgres." },
  { name: "Trademark infringement detection · Zaytrics", body: "Logo-similarity model at 85%+ accuracy that cut manual review about 70%." },
  { name: "KindlMedia chat", body: "Real-time chat between clients and businesses with reliable delivery and presence.", url: "https://kb.mycrmsupport.com/kindlmedia1" },
  { name: "TM Inspector", body: "Trademark monitoring: similarity search, watch lists and infringement alerts." },
  { name: "ViseWealth", body: "Wealth and portfolio tracking with returns and allocation dashboards." },
  { name: "WowNFT", body: "NFT marketplace with wallet auth, minting, listings and auctions." },
  { name: "Liver tumor segmentation", body: "Final-year project: U-Net segmentation of liver and tumors in CT scans." },
];
---

<BaseLayout
  title={PAGE_SEO.projects.title}
  description={PAGE_SEO.projects.description}
  sideBarActiveItemID="projects"
  wide
>
  <header class="max-w-3xl">
    <p class="hand text-ember-ink text-lg -rotate-2 inline-block mb-3">the whole wall</p>
    <h1 class="display-title text-[clamp(40px,5.4vw,64px)]">Work, and how it's wired</h1>
    <p class="mt-5 text-lg text-ink-dim">
      Each product here comes with the diagram I'd draw on a whiteboard if you asked how it works. Soonbuilt
      things are mine end to end. Kindred things were built with a team, and I say which parts are mine.
    </p>
    <nav class="flex flex-wrap gap-2 mt-7" aria-label="Sections">
      <a href="#studio" class="tag-pill no-underline hover:border-ink-muted">Soonbuilt</a>
      <a href="#kindred" class="tag-pill no-underline hover:border-ink-muted">Kindred</a>
      <a href="#workbench" class="tag-pill no-underline hover:border-ink-muted">On the workbench</a>
      <a href="#earlier" class="tag-pill no-underline hover:border-ink-muted">Earlier</a>
    </nav>
  </header>

  <!-- ═══ SOONBUILT ═══ -->
  <section id="studio" class="pt-24" aria-labelledby="studio-h">
    <div class="flex items-center gap-3 mb-4">
      <svg viewBox="0 0 40 40" class="w-7 h-7 text-ember-bright" aria-hidden="true"
        ><path fill="currentColor" d="M4 13a9 9 0 0 1 9-9h7v16h16v7a9 9 0 0 1-9 9H13a9 9 0 0 1-9-9z"></path><rect
          x="24"
          y="4"
          width="12"
          height="12"
          rx="4"
          fill="currentColor"></rect></svg
      >
      <h2 id="studio-h" class="display-title text-[clamp(30px,3.8vw,44px)]">Soonbuilt</h2>
    </div>
    <p class="text-ink-dim text-lg max-w-2xl">
      My studio. Three live products, all designed, built, hosted and launched by me.
    </p>

    {
      studio.map(({ product, wiring }, i) => (
        <div class="pt-20">
          <ProductPin product={product} flip={i % 2 === 1} detail />
          <div class="mt-14">
            <Wiring wiring={wiring} />
          </div>
        </div>
      ))
    }

    <div class="grid sm:grid-cols-2 gap-10 mt-20">
      <figure class="print" style="transform: rotate(-1deg)">
        <span class="tape" aria-hidden="true"></span>
        <div class="print-frame !bg-white aspect-[16/10]">
          <img src="/media/soonbuilt/tallyreel-studio-script.webp" alt="TallyReel shows the script it wrote, with one line edited, before anything renders" loading="lazy" class="object-top" />
        </div>
        <figcaption>You read and edit the script before anything renders.</figcaption>
      </figure>
      <figure class="print" style="transform: rotate(1deg)">
        <span class="tape" aria-hidden="true"></span>
        <div class="print-frame !bg-white aspect-[16/10]">
          <img src="/media/soonbuilt/tallyreel-post.webp" alt="TallyReel Post: a week board of scheduled videos" loading="lazy" class="object-top" />
        </div>
        <figcaption>Post: pin a video to the week and it goes out on its own.</figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ KINDRED ═══ -->
  <section id="kindred" class="pt-32" aria-labelledby="kindred-h">
    <h2 id="kindred-h" class="display-title text-[clamp(30px,3.8vw,44px)]">Kindred</h2>
    <p class="mt-3 text-ink-dim text-lg max-w-2xl">
      Senior full-stack engineer since 2023. I built Kindred Practice end to end, now work across Kindred
      Workplace, and lead the memory work in Kindred Core, the AI service underneath them all.
    </p>

    {
      kindred.map(({ product, wiring }, i) => (
        <div class="pt-20">
          <ProductPin product={product} flip={i % 2 === 1} detail />
          <div class="mt-14">
            <Wiring wiring={wiring} />
          </div>
        </div>
      ))
    }

    <div class="grid gap-20 pt-24">
      <ProductPin product={kindredWorkplace} detail />
      <ProductPin product={kindredPractice} flip detail />
    </div>

    <div class="grid md:grid-cols-3 gap-4 mt-20">
      {
        moreKindred.map((m) => (
          <article class="bento-card p-6">
            <h3 class="text-lg font-extrabold tracking-[-0.01em]">{m.name}</h3>
            <p class="mt-2 text-[15px] text-ink-dim leading-relaxed">{m.body}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {m.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══ WORKBENCH ═══ -->
  <section id="workbench" class="pt-32" aria-labelledby="bench-h">
    <div class="relative max-w-2xl">
      <h2 id="bench-h" class="display-title text-[clamp(30px,3.8vw,44px)]">On the workbench</h2>
      <p class="mt-3 text-ink-dim text-lg">Prototypes, starters and open-source pieces. Some become products.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {
        workbench.map((w, i) => (
          <article class={`note note-${w.tint} !p-6`} style={`--tilt:${[-1.5, 1.2, -0.8, 1.6, -1.2][i]}deg`}>
            <span class="tape" aria-hidden="true" />
            <span class="note-tag">{w.status}</span>
            <h3 class="note-idea !text-[22px]">{w.name}</h3>
            <p class="text-[15px] leading-relaxed text-[rgba(28,25,23,.78)]">{w.body}</p>
            <p class="mt-auto pt-2 text-[13px] font-semibold text-[rgba(28,25,23,.6)]">{w.stack}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══ EARLIER ═══ -->
  <section id="earlier" class="pt-32" aria-labelledby="earlier-h">
    <h2 id="earlier-h" class="display-title text-[clamp(30px,3.8vw,44px)]">Earlier</h2>
    <p class="mt-3 text-ink-dim text-lg max-w-2xl">Client work and projects from Extendly, Zaytrics and university.</p>
    <ul class="sheet list-none m-0 mt-10 p-4 sm:p-6 grid sm:grid-cols-2 gap-x-10">
      {
        earlier.map((e) => (
          <li class="py-4 border-b border-ink-line">
            {e.url ? (
              <a href={e.url} target="_blank" rel="noopener" class="font-bold text-ink-text no-underline hover:text-ember-ink">
                {e.name} ↗
              </a>
            ) : (
              <span class="font-bold">{e.name}</span>
            )}
            <p class="text-[15px] text-ink-dim mt-1">{e.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
