---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    Senior Software Engineer with 5 years of experience leading development of scalable SaaS and
    AI-driven platforms from concept to production. Skilled across the full stack with Node.js,
    Django, React, and AWS, and recently focused on LLMs and agent-based automation to bring
    intelligence into real-world products. Known for combining technical leadership with a strong
    product mindset, delivering reliable, user-centered systems that balance performance,
    maintainability, and innovation.
  </div>

  <div class="mb-5">
    <a href="/danish-siddique-resume.pdf" target="_blank" class="btn btn-outline">Download full resume (PDF)</a>
  </div>

  <div class="mb-5 mt-10">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Senior Full Stack Engineer at Mynd"
      subtitle="Sept 2023 - Present · Mynd, Canada (Remote)"
    >
      <ul class="list-disc ml-5 mt-2">
        <li>Led development of a practice management platform powering operations for 200+ therapists — unifying scheduling, billing, and clinical documentation in one seamless system.</li>
        <li>Designed the end-to-end architecture with Node.js (TypeScript), Django, and AWS Lambda, delivering a low-latency, event-driven backend handling thousands of concurrent sessions.</li>
        <li>Built an AI-powered note-taking and automation system using GPT, Gemini, and LangChain.</li>
        <li>Pioneered LLM-driven automation with LangChain and Inngest — multi-agent systems that analyze conversations, generate insights, and orchestrate intelligent workflows.</li>
        <li>Delivered a modern, accessible front-end with React, Chakra UI, and Tailwind CSS, improving onboarding flow and therapist productivity.</li>
        <li>Integrated real-time communication via LiveKit, AWS Chime, and Deepgram — secure video calls, live transcription, and chat across therapy sessions.</li>
      </ul>
    </TimeLineElement>
    <TimeLineElement
      title="Full Stack Developer at Extendly"
      subtitle="Apr 2023 - May 2024 · Extendly, Canada (Remote)"
    >
      <ul class="list-disc ml-5 mt-2">
        <li>Built a RAG-powered chatbot for contextual customer support using OpenAI, FastAPI, and PostgreSQL — improving response accuracy and reducing manual support load.</li>
        <li>Designed and developed responsive, cross-platform interfaces with React.</li>
        <li>Integrated third-party APIs into SaaS workflows using AWS Lambda and a serverless architecture, enabling automation and data sync across platforms.</li>
      </ul>
    </TimeLineElement>
    <TimeLineElement
      title="Full Stack Developer at Zaytrics Pvt Ltd"
      subtitle="Sep 2020 - Apr 2023 · Zaytrics, Islamabad, Pakistan"
    >
      <ul class="list-disc ml-5 mt-2">
        <li>Created an ML-based system for detecting trademark infringement in logos with 85%+ accuracy — reducing manual review effort by 70%.</li>
        <li>Built multiple apps with Node.js, React, Flask, and PostgreSQL — tools for legal and marketing automation.</li>
        <li>Refactored PostgreSQL and MongoDB databases to boost query speed and scalability under increasing data loads.</li>
      </ul>
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Key Projects</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Mynd"
      subtitle="https://mynd.app"
    >
      AI-powered practice management platform for therapists — video sessions, automated note-taking, RAG-based chat, scheduling, billing, and secure client communication.
    </TimeLineElement>
    <TimeLineElement
      title="Medimap"
      subtitle="https://medimap.ca/"
    >
      A healthcare platform helping patients find nearby walk-in clinics, urgent care centers, and other providers in real time.
    </TimeLineElement>
    <TimeLineElement
      title="KindlMedia"
      subtitle="https://kb.mycrmsupport.com/kindlmedia1"
    >
      Custom chat system supporting real-time communication between clients and businesses.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="BS Computer Science"
      subtitle="Sep 2017 - Jun 2021 at Air University, Islamabad, Pakistan"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <div class="mb-10">
    <div class="font-semibold mb-1">Languages</div>
    <ul class="list-disc md:columns-3 columns-2 mx-6 mb-4">
      <li>TypeScript</li>
      <li>Python</li>
      <li>JavaScript</li>
    </ul>

    <div class="font-semibold mb-1">Frameworks &amp; Libraries</div>
    <ul class="list-disc md:columns-3 columns-2 mx-6 mb-4">
      <li>Node.js</li>
      <li>Django</li>
      <li>Flask</li>
      <li>React</li>
      <li>Vue</li>
      <li>FastAPI</li>
      <li>Fastify</li>
    </ul>

    <div class="font-semibold mb-1">Databases</div>
    <ul class="list-disc md:columns-3 columns-2 mx-6 mb-4">
      <li>PostgreSQL</li>
      <li>MySQL</li>
      <li>MongoDB</li>
      <li>DynamoDB</li>
      <li>Elasticsearch</li>
    </ul>

    <div class="font-semibold mb-1">Cloud</div>
    <ul class="list-disc md:columns-3 columns-2 mx-6 mb-4">
      <li>AWS</li>
      <li>GCP</li>
    </ul>

    <div class="font-semibold mb-1">AI &amp; Automation</div>
    <ul class="list-disc md:columns-3 columns-2 mx-6 mb-4">
      <li>GPT</li>
      <li>Gemini</li>
      <li>LangChain</li>
      <li>LLM agents</li>
      <li>RAG</li>
      <li>Vector search</li>
      <li>Inngest</li>
      <li>Deepgram</li>
    </ul>
  </div>
</BaseLayout>
