---
import BaseLayout from "../layouts/BaseLayout.astro";
import CoverLetterDoc from "../components/CoverLetterDoc.astro";
import { baseLetter } from "../data/coverLetter";
---

<BaseLayout title="Cover Letter" sideBarActiveItemID="cover-letter">
  <!-- Toolbar (screen only) -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden">
    <h1 class="text-3xl font-bold">Cover Letter</h1>
    <a href="/cover-letter/print?auto=1" target="_blank" class="btn btn-primary btn-sm">Save as PDF</a>
  </div>

  <article
    class="cover bg-white text-[#111827] shadow-xl rounded-lg p-10 print:p-0 print:shadow-none print:rounded-none"
  >
    <CoverLetterDoc letter={baseLetter} />
  </article>
</BaseLayout>

<style is:global>
  @media print {
    @page {
      size: letter;
      margin: 0.75in;
    }

    html,
    body {
      background: white !important;
      color: #111827 !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
    }

    .drawer-side,
    .drawer-overlay,
    .navbar,
    body > div > div > header,
    body footer,
    .print\:hidden {
      display: none !important;
    }

    .drawer,
    .drawer-content,
    main {
      display: block !important;
      padding: 0 !important;
      margin: 0 !important;
      max-width: none !important;
      width: 100% !important;
      background: white !important;
      box-shadow: none !important;
      overflow: visible !important;
    }

    .cover {
      background: white !important;
      color: #111827 !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      max-width: none !important;
      width: 100% !important;
      position: static !important;
    }

    .cover,
    .cover * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .cover a {
      color: #0f2a4a !important;
      text-decoration: none !important;
    }

    a[href]::after {
      content: "" !important;
    }
  }
</style>
