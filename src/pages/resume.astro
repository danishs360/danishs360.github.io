---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeDoc from "../components/ResumeDoc.astro";
import { baseResume } from "../data/resume";
---

<BaseLayout title="Resume" sideBarActiveItemID="resume">
  <!-- Toolbar (screen only) -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden">
    <h1 class="text-3xl font-bold">Resume</h1>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/resume/ats" target="_blank" class="btn btn-outline btn-sm">ATS version</a>
      <a href="/resume/europass" target="_blank" class="btn btn-outline btn-sm">Europass</a>
      <a href="/resume/print?auto=1" target="_blank" class="btn btn-primary btn-sm">Save as PDF</a>
    </div>
  </div>

  <article
    class="resume bg-white text-[#111827] shadow-xl rounded-lg p-10 print:p-0 print:shadow-none print:rounded-none"
  >
    <ResumeDoc resume={baseResume} />
  </article>
</BaseLayout>

<style is:global>
  @media print {
    @page {
      size: letter;
      margin: 0.5in;
    }

    html,
    body {
      background: white !important;
      color: #111827 !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
    }

    /* Hide all chrome: drawer sidebar, mobile header, footer, toolbar */
    .drawer-side,
    .drawer-overlay,
    .navbar,
    body > div > div > header,
    body footer,
    .print\:hidden {
      display: none !important;
    }

    /* Flatten the drawer/main containers so the resume can flow full width */
    .drawer,
    .drawer-content,
    main {
      display: block !important;
      padding: 0 !important;
      margin: 0 !important;
      max-width: none !important;
      width: 100% !important;
      background: white !important;
      box-shadow: none !important;
      overflow: visible !important;
    }

    .resume {
      background: white !important;
      color: #111827 !important;
      padding: 0 !important;
      margin: 0 !important;
      box-shadow: none !important;
      border-radius: 0 !important;
      max-width: none !important;
      width: 100% !important;
      position: static !important;
    }

    /* Force ALL color/background to print (otherwise Chrome strips bg/colors) */
    .resume,
    .resume * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .resume a {
      color: #0f2a4a !important;
      text-decoration: none !important;
    }

    /* Avoid awkward page breaks: only keep individual bullets from splitting */
    .resume li {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    a[href]::after {
      content: "" !important;
    }
  }
</style>
