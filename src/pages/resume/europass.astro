---
import ResumeDocEuropass from "../../components/ResumeDocEuropass.astro";
import type { EuropassExtras } from "../../components/ResumeDocEuropass.astro";
import { baseResume, name } from "../../data/resume";

// ---------------------------------------------------------------------------
// EDIT ME: Europass requires personal details and language skills that a
// normal CV omits. Defaults below are reasonable but UNVERIFIED — correct them
// (especially date of birth and the CEFR language levels) before sending.
//   CEFR scale: A1, A2 (basic) · B1, B2 (independent) · C1, C2 (proficient)
//   Leave dateOfBirth / gender as "" to omit those rows.
// ---------------------------------------------------------------------------
const extras: EuropassExtras = {
  personal: {
    dateOfBirth: "05/12/1999",
    nationality: "Pakistani",
    gender: "Male",
  },
  languages: {
    mother: "Urdu",
    others: [
      {
        name: "English",
        listening: "C1",
        reading: "C1",
        spokenProduction: "C1",
        spokenInteraction: "C1",
        writing: "C1",
      },
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{name} CV (Europass)</title>
    <meta name="robots" content="noindex" />
    <style is:inline>
      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        color: #1a1a1a;
        font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .toolbar {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .toolbar .tag {
        background: #0e4194;
        color: #fff;
        font-size: 11px;
        font-weight: 500;
        padding: 6px 10px;
        border-radius: 6px;
        opacity: 0.9;
      }
      .toolbar button,
      .toolbar a {
        background: #0e4194;
        color: white;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      }
      .toolbar a.secondary {
        background: white;
        color: #0e4194;
        border: 1px solid #D1D5DB;
      }
      .toolbar button:hover { background: #0b3578; }

      .resume {
        max-width: 8.5in;
        margin: 32px auto;
        background: white;
        color: #1a1a1a;
        padding: 0.6in;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        border-radius: 4px;
      }

      @media print {
        @page { size: A4; margin: 0.6in; }
        html, body { background: white !important; }
        .toolbar { display: none !important; }
        .resume {
          margin: 0 !important;
          padding: 0 !important;
          box-shadow: none !important;
          border-radius: 0 !important;
          max-width: none !important;
          width: 100% !important;
        }
        a { color: #0e4194 !important; text-decoration: none !important; }
        a[href]::after { content: "" !important; }
        li { page-break-inside: avoid; break-inside: avoid; }
        *, *::before, *::after {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }

      @media screen and (max-width: 600px) {
        .resume { margin: 16px; padding: 24px; }
        .toolbar { top: 10px; right: 10px; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <span class="tag">Europass</span>
      <a href="/resume" class="secondary">← Back</a>
      <button id="print-btn">Save as PDF</button>
    </div>

    <article class="resume">
      <ResumeDocEuropass resume={baseResume} extras={extras} />
    </article>

    <script is:inline>
      document.getElementById("print-btn").addEventListener("click", () => window.print());

      if (new URLSearchParams(location.search).get("auto") === "1") {
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => setTimeout(() => window.print(), 200));
        } else {
          window.addEventListener("load", () => setTimeout(() => window.print(), 600));
        }
      }
    </script>
  </body>
</html>
