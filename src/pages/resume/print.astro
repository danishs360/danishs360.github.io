<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Danish Siddique — Resume</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <style is:inline>
      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        color: #111827;
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .toolbar {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10;
        display: flex;
        gap: 8px;
      }
      .toolbar button,
      .toolbar a {
        background: #0F2A4A;
        color: white;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      }
      .toolbar a.secondary {
        background: white;
        color: #0F2A4A;
        border: 1px solid #D1D5DB;
      }
      .toolbar button:hover { background: #14365a; }

      .resume {
        max-width: 8.5in;
        margin: 32px auto;
        background: white;
        color: #111827;
        padding: 0.6in;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        border-radius: 4px;
      }

      .serif { font-family: "Newsreader", ui-serif, Georgia, serif; }
      .mono { font-family: "JetBrains Mono", ui-monospace, Consolas, monospace; }

      .header {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 14px;
        margin-bottom: 14px;
        border-bottom: 1px solid #E5E5E5;
      }
      .header-name { font-family: "Newsreader", serif; font-weight: 600; font-size: 28px; line-height: 1.1; color: #0F2A4A; margin: 0; }
      .header-role { font-family: "Newsreader", serif; font-style: italic; font-size: 12.5px; color: #525252; margin: 2px 0 0 0; }
      .contact-col { display: flex; flex-direction: column; gap: 3px; font-size: 10.5px; color: #525252; align-items: flex-end; }
      .contact-line { display: flex; align-items: center; gap: 6px; color: inherit; text-decoration: none; }
      .contact-line svg { width: 11px; height: 11px; flex-shrink: 0; fill: currentColor; }
      a.contact-line { color: #0F2A4A; }


      .section-label {
        font-family: "Newsreader", serif;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: #0F2A4A;
        border-bottom: 1px solid #E5E5E5;
        padding-bottom: 4px;
        margin: 0 0 10px 0;
      }

      section { margin-bottom: 18px; }
      .summary p { font-size: 12px; line-height: 1.55; color: #1f2937; margin: 0; }
      .navy { color: #0F2A4A; font-weight: 500; }
      strong, b { font-weight: 600; }

      .role { margin-bottom: 14px; page-break-inside: avoid; break-inside: avoid; }
      .role-header { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
      .role-company { font-family: "Newsreader", serif; font-weight: 600; font-size: 13.5px; color: #111827; }
      .role-company .mute { font-weight: 400; color: #525252; }
      .role-meta { font-size: 10.5px; color: #525252; white-space: nowrap; }
      .role-title { font-style: italic; font-size: 11.5px; color: #374151; margin-bottom: 1px; }
      .role-stack { font-family: "JetBrains Mono", monospace; font-size: 9.5px; color: #525252; margin-bottom: 6px; }

      ul {
        list-style: none;
        margin: 4px 0 0 0;
        padding-left: 0;
        font-size: 11.5px;
        line-height: 1.45;
        color: #1f2937;
      }
      ul li {
        padding-left: 14px;
        text-indent: -14px;
        margin-bottom: 3px;
      }
      ul li::before {
        content: "\2022\00a0\00a0";
        font-weight: 700;
        color: #1f2937;
      }

      .projects-list > div { margin-bottom: 6px; }
      .project-name { font-family: "Newsreader", serif; font-weight: 600; }
      .project-meta { font-size: 10.5px; color: #525252; }
      .project-desc { color: #374151; font-size: 11.5px; line-height: 1.4; }
      a.project-link { color: #0F2A4A; text-decoration: none; font-size: 10.5px; }
      a.project-link:hover { text-decoration: underline; }

      .skills { font-size: 11.5px; line-height: 1.55; color: #1f2937; }
      .skills > div { margin-bottom: 2px; }
      .skill-label { color: #0F2A4A; font-weight: 600; }

      .edu-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; font-size: 11.5px; }
      .edu-row .degree { font-family: "Newsreader", serif; font-weight: 600; color: #111827; }
      .edu-row .school { color: #374151; }
      .edu-row .place { color: #525252; }
      .edu-row .date { font-size: 10.5px; color: #525252; white-space: nowrap; }

      @media print {
        @page { size: letter; margin: 0.5in; }
        html, body { background: white !important; }
        .toolbar { display: none !important; }
        .resume {
          margin: 0 !important;
          padding: 0 !important;
          box-shadow: none !important;
          border-radius: 0 !important;
          max-width: none !important;
          width: 100% !important;
        }
        /* Force header horizontal regardless of print viewport width */
        .header {
          display: flex !important;
          flex-direction: row !important;
          align-items: flex-start !important;
          justify-content: space-between !important;
          gap: 16px !important;
        }
        .contact-col {
          display: flex !important;
          flex-direction: column !important;
          align-items: flex-end !important;
        }
        a { color: inherit !important; text-decoration: none !important; }
        a[href]::after { content: "" !important; }
        section, .role, ul, li { page-break-inside: avoid; break-inside: avoid; }
        *, *::before, *::after {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }

      /* Mobile/narrow-screen layout — explicitly scoped to "screen" so it never affects print */
      @media screen and (max-width: 600px) {
        .header { flex-direction: column; }
        .contact-col { align-items: flex-start; }
        .resume { margin: 16px; padding: 24px; }
        .toolbar { top: 10px; right: 10px; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a href="/resume" class="secondary">← Back</a>
      <button id="print-btn">Save as PDF</button>
    </div>

    <article class="resume">
      <header class="header">
        <div>
          <h1 class="header-name">Danish Siddique</h1>
          <p class="header-role">Senior Software Engineer</p>
        </div>
        <div class="contact-col">
          {
            contacts.map((c) =>
              c.href ? (
                <a class="contact-line" href={c.href}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={c.path} />
                  </svg>
                  <span>{c.text}</span>
                </a>
              ) : (
                <span class="contact-line">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={c.path} />
                  </svg>
                  <span>{c.text}</span>
                </span>
              )
            )
          }
        </div>
      </header>

      <section class="summary">
        <p>
          Senior AI Engineer &amp; Full-Stack Developer with 5+ years building production software
          used by thousands. At <span class="navy">Kindred</span> (formerly Mynd), led the
          development of an AI-powered platform serving 200+ therapists, including automated
          note-taking, intelligent chat assistants, and AI workflows that handle support tickets
          and bug reports automatically. Comfortable owning products end-to-end, from architecture
          to launch, across modern web technologies (Node.js, Django, React, AWS), and a heavy user
          of AI-assisted development tools like Claude Code and Cursor.
        </p>
      </section>

      <section>
        <h2 class="section-label">Experience</h2>

        <div class="role">
          <div class="role-header">
            <div class="role-company">Kindred <span class="mute">(formerly Mynd)</span></div>
            <div class="role-meta">Sept 2023 – Present · Remote</div>
          </div>
          <div class="role-title">Senior Full-Stack Engineer</div>
          <div class="role-stack">TypeScript · Node.js · Django · AWS Lambda · React · LangChain · Goose · Inngest · LiveKit · Deepgram</div>
          <ul>
            <li>Currently shipping <b>Kindred Workplace</b>, an emotional-intelligence platform for teams. Own product engineering across React, Node.js (TypeScript), and Django, including embedded AI features.</li>
            <li>Built <b>Kindred Practice (formerly Mynd)</b>, an AI-driven practice management platform for therapists. Scaled to 1,000+ users. Owned scheduling, billing, clinical documentation, and AI features end-to-end.</li>
            <li>Shipped <b>developer-loop automations</b> across the engineering org. Sentry incidents and Gleap support tickets route through <b>Goose</b> agents that reproduce, implement, and open ready-to-review pull requests, cutting incident-to-fix time substantially.</li>
            <li>Built a <b>universal in-app AI agent</b> capable of executing arbitrary product actions through tool calls, with structured outputs, scoped permissions, and per-call guardrails.</li>
            <li>Deployed multiple <b>production RAG pipelines</b> across clinical context, customer support, and internal knowledge surfaces. Pgvector storage, custom chunking strategies, eval-driven iteration.</li>
            <li>Treat AI as core engineering infrastructure: authored team-wide <b>Cursor rules</b> and <b>Claude Code</b> skills encoding Kindred's codebase conventions, sustaining ~2–3× shipping velocity on new features and cutting new-hire ramp from weeks to days.</li>
            <li>Designed event-driven backend on Node.js (TypeScript), Django, and AWS Lambda. Integrated real-time video, transcription, and chat via LiveKit, AWS Chime, and Deepgram.</li>
          </ul>
        </div>

        <div class="role">
          <div class="role-header">
            <div class="role-company">Extendly</div>
            <div class="role-meta">Apr 2023 – May 2024 · Remote</div>
          </div>
          <div class="role-title">Full-Stack Developer</div>
          <div class="role-stack">Python · OpenAI · FastAPI · PostgreSQL · React · AWS Lambda</div>
          <ul>
            <li>Built a <b>RAG-powered customer support chatbot</b> on OpenAI, FastAPI, and PostgreSQL. Improved response accuracy and significantly reduced manual support load.</li>
            <li>Designed and shipped cross-platform React interfaces for the SaaS product.</li>
            <li>Integrated third-party APIs into SaaS workflows on AWS Lambda using a serverless architecture, enabling automation and data sync across platforms.</li>
          </ul>
        </div>

        <div class="role">
          <div class="role-header">
            <div class="role-company">Zaytrics Pvt Ltd</div>
            <div class="role-meta">Sep 2020 – Apr 2023 · Islamabad</div>
          </div>
          <div class="role-title">Full-Stack Developer</div>
          <div class="role-stack">Node.js · React · Flask · PostgreSQL · MongoDB · TensorFlow</div>
          <ul>
            <li>Built an <b>ML-based trademark infringement detection</b> system on logos. Reached 85%+ accuracy. Reduced manual review effort by ~70%.</li>
            <li>Delivered multiple applications across Node.js, React, Flask, and PostgreSQL for legal and marketing automation.</li>
            <li>Refactored PostgreSQL and MongoDB databases. Improved query performance and scalability under growing data loads.</li>
          </ul>
        </div>
      </section>

      <section>
        <h2 class="section-label">Selected Projects</h2>
        <div class="projects-list">
          <div>
            <span class="project-name">Kindred Workplace</span>
            <span class="project-meta"> · </span>
            <a class="project-link" href="https://kindredworkplace.com">kindredworkplace.com</a>
            <div class="project-desc">Emotional-intelligence platform for teams. Full-stack delivery, real-time features, and embedded AI.</div>
          </div>
          <div>
            <span class="project-name">Kindred Practice</span>
            <span class="project-meta"> · </span>
            <a class="project-link" href="https://kindredpractice.com">kindredpractice.com</a>
            <span class="project-meta"> (formerly mynd.app)</span>
            <div class="project-desc">AI-powered practice management platform for therapists. Video, automated note-taking, RAG-based chat, scheduling, billing.</div>
          </div>
          <div>
            <span class="project-name">Developer-Loop Automations</span>
            <span class="project-meta"> · internal · Goose-based agents</span>
            <div class="project-desc">Sentry incidents and Gleap tickets routed to Goose agents that scope, implement, and open pull requests.</div>
          </div>
          <div>
            <span class="project-name">Medimap</span>
            <span class="project-meta"> · </span>
            <a class="project-link" href="https://medimap.ca">medimap.ca</a>
            <div class="project-desc">Healthcare platform helping patients find nearby walk-in clinics and providers in real time.</div>
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-label">Skills</h2>
        <div class="skills">
          <div><span class="skill-label">Languages</span> · TypeScript, Python, JavaScript</div>
          <div><span class="skill-label">Backend</span> · Node.js, Django, FastAPI, Flask, Fastify</div>
          <div><span class="skill-label">Frontend</span> · React, Vue, Tailwind CSS, Chakra UI</div>
          <div><span class="skill-label">Data</span> · PostgreSQL, MongoDB, DynamoDB, Elasticsearch, pgvector</div>
          <div><span class="skill-label">Cloud</span> · AWS (Lambda, Chime), GCP</div>
          <div><span class="skill-label">AI stack</span> · Claude Code, Cursor, Goose, MCP, LangChain, Inngest, GPT, Gemini, RAG, vector search, evals, Deepgram, LiveKit</div>
        </div>
      </section>

      <section style="margin-bottom: 0;">
        <h2 class="section-label">Education</h2>
        <div class="edu-row">
          <div>
            <span class="degree">BS Computer Science</span>,
            <span class="school">Air University</span>,
            <span class="place">Islamabad, Pakistan</span>
          </div>
          <div class="date">Sep 2017 – Jun 2021</div>
        </div>
      </section>
    </article>

    <script is:inline>
      document.getElementById("print-btn").addEventListener("click", () => window.print());

      // Auto-trigger print if ?auto=1 in URL (used when "Save as PDF" is clicked from /resume)
      if (new URLSearchParams(location.search).get("auto") === "1") {
        // Wait for fonts to load, then print
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => setTimeout(() => window.print(), 200));
        } else {
          window.addEventListener("load", () => setTimeout(() => window.print(), 600));
        }
      }
    </script>
  </body>
</html>
