---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
import { PAGE_SEO } from "../../config";
---

<BaseLayout
  title={PAGE_SEO.blog.title}
  description={PAGE_SEO.blog.description}
  sideBarActiveItemID="blog"
  wide
>
  <PageHeader
    label="Writing"
    title="Blog"
    description="Notes on AI engineering, agents, RAG, and building products that hold up in production."
  />

  {
    page.data.length === 0 ? (
      <div class="bento-card p-6 border-l-2 border-ember">
        <p class="font-medium text-ink-text">Nothing here yet.</p>
        <p class="text-sm text-ink-dim mt-1">Check back soon.</p>
      </div>
    ) : (
      <div class="grid gap-4">
        {page.data.map((post) => (
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
            tags={post.data.tags}
          />
        ))}
      </div>
    )
  }

  <div class="flex justify-between mt-10">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn-ghost-line !text-sm">
          ← Recent posts
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn-ghost-line !text-sm">
          Older posts →
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>
