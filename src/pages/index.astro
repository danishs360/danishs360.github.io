---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import ProductPin from "../components/ProductPin.astro";
import ReelWall from "../components/ReelWall.astro";
import Wiring from "../components/Wiring.astro";
import { getCollection } from "astro:content";
import { baseResume } from "../data/resume";
import createSlug from "../lib/createSlug";
import { SITE_URL, SITE_DESCRIPTION, SOCIAL } from "../config";
import {
  tallyreel,
  roundZero,
  soonbuilt,
  kindredCore,
  kindredMemory,
  agentOps,
  kindredWorkplace,
  kindredPractice,
  moreKindred,
  agents,
  wirings,
} from "../data/work";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const tally = [
  { value: "3", label: "products live this year" },
  { value: "200+", label: "therapists on Kindred Practice" },
  { value: "25", label: "AI capabilities behind one key" },
  { value: "15", label: "networks from one posting queue" },
];

const kindredNotes = [kindredCore, kindredMemory, agentOps];
const kindredPrints = [kindredWorkplace, kindredPractice];

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Danish Siddique",
      url: SITE_URL,
      description: SITE_DESCRIPTION,
      author: { "@id": `${SITE_URL}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${SITE_URL}/#person`,
      name: "Danish Siddique",
      url: SITE_URL,
      email: "mailto:idanishsiddique@gmail.com",
      jobTitle: "Senior Full-Stack Engineer",
      worksFor: { "@type": "Organization", name: "Kindred" },
      founder: { "@type": "Organization", name: "Soonbuilt", url: "https://soonbuilt.com" },
      description: SITE_DESCRIPTION,
      sameAs: [SOCIAL.github, SOCIAL.linkedin],
      knowsAbout: [
        "Full-Stack Development",
        "LLM Agents",
        "Agent Memory",
        "RAG",
        "On-device AI",
        "Voice AI",
        "TypeScript",
        "Python",
      ],
    },
  ],
};
---

<BaseLayout sideBarActiveItemID="home" wide>
  <JsonLd schema={personSchema} />

  <!-- ═══ HERO: the wall ═══ -->
  <section class="intro" aria-labelledby="hero-h">
    <div class="hero-copy">
      <p class="hand text-ember-ink text-lg -rotate-2 mb-4 inline-block">hi, I'm Danish</p>
      <h1 id="hero-h" class="display-title text-[clamp(44px,5.6vw,72px)] !tracking-[-0.04em] !leading-[1.02]">
        I build the product, and the AI <span class="hand text-ember !tracking-[-0.02em]">underneath it.</span>
      </h1>
      <p class="mt-6 text-[clamp(18px,1.6vw,20px)] leading-normal text-ink-dim max-w-[31em]">
        Senior full-stack engineer. At Kindred I lead the memory work in Kindred Core, the AI service every
        product there calls. After hours I run Soonbuilt, which just shipped TallyReel and Round Zero.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3.5 mt-8">
        <a href="#work" class="btn-ember !h-14 !px-7 !text-[17px]">See what's on the wall</a>
        <a href="#wiring" class="textlink">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13.5 6.5L19 12l-5.5 5.5"></path></svg>
          <span>or see how it's wired</span>
        </a>
      </div>
      <p class="mt-5 text-[15px] text-ink-muted">Islamabad · remote · open to senior full-stack and applied AI roles</p>
    </div>

    <div class="hero-wall" aria-label="What I've been working on">
      <p class="hand hw-arrow" aria-hidden="true">made on a laptop →</p>

      <a href="#tallyreel" class="note note-peach hw-live">
        <span class="tape" aria-hidden="true"></span>
        <span class="note-tag">Just shipped</span>
        <span class="note-idea">TallyReel: one line in, a finished video out</span>
        <span class="hw-go">See it <span aria-hidden="true">→</span></span>
      </a>

      <figure class="print hw-print">
        <span class="tape" aria-hidden="true"></span>
        <div class="print-frame">
          <video
            id="heroVideo"
            muted
            playsinline
            loop
            autoplay
            preload="metadata"
            poster="/media/tallyreel/ocean-depth.jpg"
            aria-label="A real video made by TallyReel from the line: How deep the ocean really is"
          >
            <source src="/media/tallyreel/ocean-depth.mp4" type="video/mp4" />
          </video>
          <button class="hw-sound" id="heroSound" type="button" aria-pressed="false" aria-label="Turn sound on">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path><path d="M15.5 9a4.5 4.5 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11"></path></svg>
          </button>
        </div>
        <figcaption>a real TallyReel render, unedited</figcaption>
      </figure>

      <a href="#soonbuilt" class="note note-butter hw-2">
        <span class="tape" aria-hidden="true"></span>
        <span class="note-tag">My studio</span>
        <span class="note-idea">Soonbuilt: AI that runs on your computer</span>
      </a>
      <a href="#kindred" class="note note-sky hw-3">
        <span class="note-tag">At Kindred</span>
        <span class="note-idea">Kindred Core: one AI service, every product</span>
      </a>
      <a href="#round-zero" class="note note-mint hw-4">
        <span class="tape" aria-hidden="true"></span>
        <span class="note-tag">Live</span>
        <span class="note-idea">Round Zero: interviews with a voice AI</span>
      </a>
      <a href="#wiring" class="note note-lilac hw-5">
        <span class="note-tag">Memory</span>
        <span class="note-idea">Supersede, don't delete. Forget on request.</span>
      </a>
      <a href="#reels" class="mini-print hw-mp" aria-label="Watch more TallyReel videos">
        <span class="print-frame"><img src="/media/tallyreel/pompeii.jpg" alt="" width="540" height="960" /></span>
      </a>
    </div>
  </section>

  <!-- the tally -->
  <section class="mt-10 sm:mt-4" aria-label="In numbers">
    <ul class="tally">
      {
        tally.map((t) => (
          <li>
            <b>{t.value}</b>
            <span>{t.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ═══ PINNED WORK ═══ -->
  <section class="block" id="work" aria-labelledby="work-h">
    <div class="head-left">
      <h2 id="work-h" class="display-title text-[clamp(32px,4.2vw,48px)]">Three products on the wall. All live.</h2>
      <p class="mt-4 text-ink-dim text-lg">
        Built and run through Soonbuilt, my studio: design, code, infrastructure, billing and the launch.
      </p>
      <p class="hand head-aside" aria-hidden="true">all mine, start to finish</p>
    </div>
    <div class="grid gap-20 sm:gap-24 mt-14">
      <ProductPin product={tallyreel} />
      <ProductPin product={roundZero} flip />
      <ProductPin product={soonbuilt} />
    </div>
  </section>

  <!-- ═══ REELS ═══ -->
  <section class="block" id="reels" aria-labelledby="reels-h">
    <div class="head-left">
      <h2 id="reels-h" class="display-title text-[clamp(32px,4.2vw,48px)]">Every note here became a real video</h2>
      <p class="mt-4 text-ink-dim text-lg">
        Each idea was typed into TallyReel as one line and rendered on a laptop without a single edit. Peel a note
        to watch what it turned into, with sound.
      </p>
      <p class="hand head-aside" aria-hidden="true">go on, peel one</p>
    </div>
    <div class="mt-10">
      <ReelWall />
    </div>
  </section>

  <!-- ═══ KINDRED ═══ -->
  <section class="block" id="kindred" aria-labelledby="kindred-h">
    <div class="head-left">
      <h2 id="kindred-h" class="display-title text-[clamp(32px,4.2vw,48px)]">At Kindred: the AI underneath the products</h2>
      <p class="mt-4 text-ink-dim text-lg">
        Kindred makes mental-health and emotional-intelligence products. Since 2023 I've gone from building one of
        them end to end to working on the shared layer they all stand on.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-7 mt-12">
      {
        kindredNotes.map((k, i) => (
          <article class={`note note-${k.tint} kin-note`} style={`--tilt:${[-1.5, 1, -1][i]}deg`}>
            <span class="tape" aria-hidden="true" />
            <span class="note-tag">{k.kicker}</span>
            <h3 class="text-[22px] font-extrabold tracking-[-0.02em] leading-tight">{k.name}</h3>
            <p class="note-idea !text-[17px]">{k.line}</p>
            <ul class="kin-facts">
              {k.facts.slice(0, 3).map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="grid md:grid-cols-2 gap-10 mt-16">
      {
        kindredPrints.map((k, i) => (
          <a href={k.url} target="_blank" rel="noopener" class="group no-underline text-ink-text">
            <figure class="print" style={`transform: rotate(${i ? 1 : -1}deg)`}>
              <span class="tape" aria-hidden="true" />
              <div class="print-frame !bg-white aspect-[16/10]">
                <img src={k.img} alt={k.imgAlt} loading="lazy" class="object-top transition-transform duration-500 group-hover:scale-[1.02]" />
              </div>
            </figure>
            <div class="mt-5 flex items-baseline gap-3 flex-wrap">
              <h3 class="text-2xl font-extrabold tracking-[-0.02em]">{k.name}</h3>
              <span class="text-sm text-ink-muted">{k.urlText} ↗</span>
            </div>
            <p class="mt-2 text-ink-dim text-[16px]">{k.body}</p>
          </a>
        ))
      }
    </div>

    <div class="grid md:grid-cols-3 gap-4 mt-14">
      {
        moreKindred.map((m) => (
          <article class="bento-card p-6">
            <h3 class="text-lg font-extrabold tracking-[-0.01em]">{m.name}</h3>
            <p class="mt-2 text-[15px] text-ink-dim leading-relaxed">{m.body}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {m.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ═══ WIRING ═══ -->
  <section class="block" id="wiring" aria-labelledby="wiring-h">
    <div class="head-left">
      <h2 id="wiring-h" class="display-title text-[clamp(32px,4.2vw,48px)]">How it's wired</h2>
      <p class="mt-4 text-ink-dim text-lg">
        The part a screenshot can't show. Pick a system to see what calls what, and where the guardrails sit.
      </p>
      <p class="hand head-aside" aria-hidden="true">pick a note</p>
    </div>

    <div class="wire-tabs" role="tablist" aria-label="Systems">
      {
        wirings.map((w, i) => (
          <button
            class={`note note-${["sky", "lilac", "peach", "mint", "butter", "butter"][i]} wire-tab`}
            role="tab"
            id={`tab-${w.id}`}
            aria-controls={`panel-${w.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            style={`--tilt:${[-2, 1.5, -1, 2, -1.5, 1][i]}deg`}
            type="button"
          >
            <span class="note-idea !text-[17px]">{w.tab}</span>
          </button>
        ))
      }
    </div>

    {
      wirings.map((w, i) => (
        <div role="tabpanel" id={`panel-${w.id}`} aria-labelledby={`tab-${w.id}`} hidden={i !== 0} class="wire-panel">
          <Wiring wiring={w} />
        </div>
      ))
    }
  </section>

  <!-- ═══ AGENTS ═══ -->
  <section class="block" aria-labelledby="agents-h">
    <div class="head-left">
      <h2 id="agents-h" class="display-title text-[clamp(32px,4.2vw,48px)]">AI that runs in production</h2>
      <p class="mt-4 text-ink-dim text-lg">
        Not demos. Systems handling real users, real money and real clinical data, with guardrails, evals and
        tracing on every call.
      </p>
    </div>
    <div class="board mt-10">
      {
        agents.map((a) => (
          <div class="board-col">
            <b>{a.tag}</b>
            <div class={`card note-${a.tint}`}>
              <strong>{a.title}</strong>
              <small>{a.desc}</small>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══ EXPERIENCE ═══ -->
  <section class="block" aria-labelledby="exp-h">
    <div class="grid lg:grid-cols-[4fr_8fr] gap-10 lg:gap-14 items-start">
      <div>
        <h2 id="exp-h" class="display-title text-[clamp(32px,4vw,46px)]">Where I've built</h2>
        <p class="mt-4 text-ink-dim">Five years of shipping, most of it with AI somewhere in the loop.</p>
        <a href="/resume" class="textlink mt-6">Full resume →</a>
      </div>
      <ol class="sheet p-6 sm:p-8 list-none m-0">
        {
          baseResume.experience.map((job) => (
            <li class="exp">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-xl font-extrabold tracking-[-0.02em]">
                  {job.company}
                  {job.note && <span class="text-ink-muted text-base font-medium"> {job.note}</span>}
                </h3>
                <span class="text-sm text-ink-muted">{job.meta}</span>
              </div>
              <p class="hand text-ember-ink mt-1">{job.title}</p>
              <ul class="mt-3 space-y-1.5">
                {job.bullets.slice(0, 2).map((b) => (
                  <li class="text-[15px] text-ink-dim leading-relaxed" set:html={b} />
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══ WRITING ═══ -->
  {
    posts.length > 0 && (
      <section class="block" aria-labelledby="blog-h">
        <div class="flex items-end justify-between gap-4">
          <h2 id="blog-h" class="display-title text-[clamp(32px,4vw,46px)]">From the notebook</h2>
          <a href="/blog/" class="textlink hidden sm:inline-flex">All writing →</a>
        </div>
        <div class="grid md:grid-cols-3 gap-6 mt-10">
          {posts.map((post, i) => (
            <a
              href={"/blog/" + createSlug(post.data.title, post.slug)}
              class={`note note-${["white", "butter", "white"][i]} !p-6 !gap-3 no-underline`}
              style={`--tilt:${[-1, 1.2, -0.6][i]}deg`}
            >
              <time class="note-tag">
                {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </time>
              <h3 class="text-xl font-extrabold tracking-[-0.02em] leading-snug">{post.data.title}</h3>
              <p class="text-[15px] text-ink-dim line-clamp-3">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- ═══ CLOSE ═══ -->
  <section class="close" aria-labelledby="close-h">
    <div class="note note-butter note-close">
      <span class="tape" aria-hidden="true"></span>
      <h2 id="close-h" class="hand text-[clamp(32px,4.4vw,46px)] leading-tight">What should we build next?</h2>
      <p class="mt-3 text-lg text-[#5a4718]">
        Open to senior full-stack and applied AI roles, and to good conversations about agents, memory and
        on-device AI.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 mt-7">
        <a href="/contact" class="btn-ember !h-14 !px-7 !text-[17px]">Get in touch</a>
        <a href="/resume/print?auto=1" target="_blank" class="textlink">Download my resume</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px;
    align-items: center;
  }
  .hero-wall {
    position: relative;
    height: 640px;
    width: 640px;
    justify-self: end;
  }
  .hero-wall > * {
    position: absolute;
  }
  .hero-wall .note {
    width: 196px;
    min-height: 150px;
    text-decoration: none;
  }
  .hw-live {
    left: 0;
    top: 44px;
    width: 224px !important;
    min-height: 196px !important;
    --tilt: -3deg;
    z-index: 3;
    outline: 3px solid #f06a1d;
    outline-offset: 5px;
  }
  .hw-go {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border: 1px solid rgba(28, 25, 23, 0.18);
    border-radius: 999px;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
  }
  .hw-arrow {
    left: 64px;
    top: -10px;
    color: #a93a0a;
    font-size: 18px;
    transform: rotate(-6deg);
  }
  .hw-print {
    left: 250px;
    top: 0;
    width: 214px;
    z-index: 2;
    transform: rotate(2deg);
  }
  .hw-print .print-frame {
    aspect-ratio: 9 / 16;
  }
  .hw-sound {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.94);
    cursor: pointer;
  }
  .hw-sound svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: #1c1917;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  .hw-sound[aria-pressed="true"] svg {
    stroke: #c7450c;
    opacity: 1;
  }
  .hw-2 {
    left: 480px;
    top: 26px;
    width: 170px !important;
    --tilt: 3deg;
  }
  .hw-3 {
    left: 12px;
    top: 318px;
    --tilt: 2.5deg;
    z-index: 2;
  }
  .hw-4 {
    left: 478px;
    top: 250px;
    width: 172px !important;
    --tilt: -2deg;
  }
  .hw-5 {
    left: 262px;
    top: 470px;
    --tilt: -3.5deg;
    z-index: 3;
  }
  .mini-print {
    width: 138px;
    z-index: 1;
    transition: transform 0.45s cubic-bezier(.16, 1, .3, 1);
  }
  .mini-print .print-frame {
    display: block;
    aspect-ratio: 9 / 16;
  }
  .hw-mp {
    left: 494px;
    top: 452px;
    transform: rotate(5deg);
  }
  .mini-print:hover {
    transform: rotate(0) translateY(-6px);
  }

  .tally {
    list-style: none;
    margin: 0;
    padding: 20px 8px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    border-top: 1px solid #ebe7e2;
    border-bottom: 1px solid #ebe7e2;
  }
  .tally li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tally b {
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .tally span {
    font-size: 14px;
    color: #6f6962;
  }

  .block {
    padding-top: 120px;
  }
  .head-left {
    position: relative;
    max-width: 660px;
  }
  .head-aside {
    position: absolute;
    right: -230px;
    bottom: 6px;
    color: #a93a0a;
    font-size: 19px;
    transform: rotate(-6deg);
  }

  .kin-note {
    padding: 26px 24px 24px;
    gap: 10px;
  }
  .kin-facts {
    list-style: none;
    margin: 6px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid rgba(28, 25, 23, 0.12);
    display: grid;
    gap: 8px;
  }
  .kin-facts li {
    font-size: 14.5px;
    line-height: 1.45;
    color: rgba(28, 25, 23, 0.74);
    padding-left: 16px;
    position: relative;
  }
  .kin-facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c7450c;
  }

  .wire-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 14px;
    margin: 40px 0 44px;
  }
  .wire-tab {
    width: auto;
    min-height: 0;
    padding: 12px 18px;
    border: 0;
    cursor: pointer;
    font: inherit;
    opacity: 0.72;
    border-radius: 4px 4px 4px 14px;
  }
  .wire-tab[aria-selected="true"] {
    opacity: 1;
    box-shadow: 0 0 0 3px #f06a1d, 0 1px 1px rgba(28, 25, 23, 0.06), 0 16px 26px -14px rgba(28, 25, 23, 0.32);
  }
  .wire-tab:hover {
    opacity: 1;
  }

  .board {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    padding: 22px;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 2px 3px rgba(28, 25, 23, 0.08), 0 26px 44px -22px rgba(28, 25, 23, 0.45);
  }
  .board-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 210px;
    padding: 10px;
    border-radius: 14px;
    background: #f6f5f3;
  }
  .board-col > b {
    font-size: 14px;
    font-weight: 700;
    color: #4f4a45;
    padding-left: 4px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    border-radius: 4px 4px 4px 14px;
    box-shadow: 0 1px 1px rgba(28, 25, 23, 0.06), 0 16px 26px -14px rgba(28, 25, 23, 0.32);
    transform: rotate(-1.5deg);
  }
  .board-col:nth-child(even) .card {
    transform: rotate(1.5deg);
  }
  .card strong {
    font-family: "Shantell Sans", sans-serif;
