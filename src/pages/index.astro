---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Danish Siddique</div>
    <div class="text-3xl py-3 font-bold">Senior Software Engineer · AI &amp; Full Stack</div>
    <div class="py-2">
      <text class="text-lg">
        I build scalable SaaS products and AI-driven systems end-to-end. Over the last 5 years
        I've led the development of platforms powering hundreds of users, with recent focus on
        <b>LLM agents</b>, <b>RAG pipelines</b>, and <b>real-time systems</b>. I work across
        the stack with Node.js (TypeScript), Django, React, and AWS.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://linkedin.com/in/sudodanish" target="_blank">Let's connect</a>
      <a href="/projects" class="btn btn-outline ml-5">
        See my work
      </a>
      <a href="/danish-siddique-resume.pdf" target="_blank" class="btn btn-outline ml-5">
        Download CV
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Featured projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="Mynd"
    img="/post_img.webp"
    desc="AI-powered practice management platform for therapists — video sessions, automated note-taking, RAG chat, scheduling, billing, and secure client communication."
    url="https://mynd.app"
    badge="LIVE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Medimap"
    img="/post_img.webp"
    desc="Healthcare platform helping patients find nearby walk-in clinics, urgent care centers, and other providers in real time."
    url="https://medimap.ca/"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="KindlMedia Chat"
    img="/post_img.webp"
    desc="Custom real-time chat system enabling direct communication between clients and businesses."
    url="https://kb.mycrmsupport.com/kindlmedia1"
  />
</BaseLayout>
