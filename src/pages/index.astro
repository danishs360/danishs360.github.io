---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <!-- HERO -->
  <section class="pt-2 pb-14">
    <div class="inline-flex items-center gap-2 text-sm px-3 py-1 rounded-full bg-base-200 border border-base-300 mb-6 fade-in-up">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
      </span>
      <span class="text-base-content/80">Product Engineer at <span class="font-semibold">Kindred</span></span>
    </div>

    <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-4 fade-in-up" style="animation-delay: 0.1s">
      <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">Danish Siddique</span>
    </h1>

    <h2 class="text-2xl md:text-3xl font-medium text-base-content/85 mb-6 fade-in-up" style="animation-delay: 0.2s">
      I build LLM agents and the developer tools to ship them.
    </h2>

    <p class="text-lg text-base-content/70 max-w-2xl leading-relaxed fade-in-up" style="animation-delay: 0.3s">
      Senior AI Engineer &amp; Full-Stack Developer with 5+ years building production software used
      by thousands. At <a href="https://kindredworkplace.com" target="_blank" class="link link-primary">Kindred</a>,
      I build AI-powered products: agent systems, automated workflows, intelligent chat assistants,
      and dev-loop automations that turn support tickets and bug reports into pull requests. I own
      products end-to-end, from architecture to launch, across modern web technologies (Node.js,
      Django, React, AWS). Heavy daily user of AI-assisted development tools like Claude Code and
      Cursor.
    </p>

    <div class="mt-8 flex flex-wrap gap-3 fade-in-up" style="animation-delay: 0.4s">
      <a class="btn btn-primary" href="/projects">View projects →</a>
      <a class="btn btn-outline" href="/resume">Resume</a>
      <a class="btn btn-ghost" href="/contact">Contact ↗</a>
    </div>
  </section>

  <!-- STATS -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
    <div class="border-l-2 border-primary pl-4">
      <div class="text-3xl font-bold">5+</div>
      <div class="text-xs uppercase tracking-wider text-base-content/60 mt-1">Years of experience</div>
    </div>
    <div class="border-l-2 border-secondary pl-4">
      <div class="text-3xl font-bold">1,000+</div>
      <div class="text-xs uppercase tracking-wider text-base-content/60 mt-1">Users in production</div>
    </div>
    <div class="border-l-2 border-accent pl-4">
      <div class="text-3xl font-bold">10+</div>
      <div class="text-xs uppercase tracking-wider text-base-content/60 mt-1">AI agents shipped</div>
    </div>
    <div class="border-l-2 border-info pl-4">
      <div class="text-3xl font-bold">70%</div>
      <div class="text-xs uppercase tracking-wider text-base-content/60 mt-1">Manual review reduced</div>
    </div>
  </section>

  <!-- NOW BUILDING -->
  <section class="mb-16">
    <div class="flex items-center gap-3 mb-4">
      <h3 class="text-2xl font-bold">Current focus</h3>
      <span class="text-xs font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-primary/10 text-primary border border-primary/30">Now</span>
    </div>
    <div class="card bg-base-200 border border-base-300 hover:border-primary/50 transition-colors">
      <div class="card-body">
        <h4 class="card-title text-xl">
          Kindred Workplace
          <span class="badge badge-outline badge-sm">SaaS · AI · Teams</span>
        </h4>
        <p class="text-base-content/80">
          Product engineering on an emotional-intelligence platform for teams. Full-stack systems,
          real-time features, and embedded AI that makes the product genuinely useful day-to-day.
        </p>
        <p class="text-base-content/80">
          In parallel, driving AI tooling adoption across the organization: developer-loop automations
          (Sentry &amp; Gleap → pull request via Goose agents), an in-app universal AI agent, and shared
          RAG infrastructure used across products.
        </p>
        <div class="card-actions mt-2">
          <a href="https://kindredworkplace.com" target="_blank" class="link link-primary text-sm">kindredworkplace.com ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AI & AUTOMATION HIGHLIGHTS -->
  <section class="mb-16">
    <h3 class="text-2xl font-bold mb-2">AI &amp; automation</h3>
    <p class="text-base-content/60 mb-6">Production systems shipped over the past six months.</p>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="card bg-base-100 border border-base-300 hover:border-primary hover:-translate-y-0.5 transition-all">
        <div class="card-body">
          <div class="text-xs font-mono uppercase tracking-wider text-primary mb-1">Developer-loop automation</div>
          <h4 class="font-bold text-lg">Sentry → GitHub pull request</h4>
          <p class="text-sm text-base-content/75">
            Goose agents subscribe to Sentry incidents, reproduce them in a sandboxed checkout, and open
            a ready-to-review pull request with the proposed fix. Closes the loop from incident to merged
            change without an engineer hand-writing the patch.
          </p>
          <div class="flex flex-wrap gap-1 mt-2">
            <span class="badge badge-sm badge-ghost">Goose</span>
            <span class="badge badge-sm badge-ghost">Sentry</span>
            <span class="badge badge-sm badge-ghost">GitHub Actions</span>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 hover:border-secondary hover:-translate-y-0.5 transition-all">
        <div class="card-body">
          <div class="text-xs font-mono uppercase tracking-wider text-secondary mb-1">Developer-loop automation</div>
          <h4 class="font-bold text-lg">Gleap ticket → GitHub pull request</h4>
          <p class="text-sm text-base-content/75">
            User-reported issues from Gleap routed to Goose agents that scope the change, implement
            the fix, and open a draft pull request. Engineers review and merge.
          </p>
          <div class="flex flex-wrap gap-1 mt-2">
            <span class="badge badge-sm badge-ghost">Goose</span>
            <span class="badge badge-sm badge-ghost">Gleap</span>
            <span class="badge badge-sm badge-ghost">LLM agents</span>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 hover:border-accent hover:-translate-y-0.5 transition-all">
        <div class="card-body">
          <div class="text-xs font-mono uppercase tracking-wider text-accent mb-1">Product AI</div>
          <h4 class="font-bold text-lg">Universal in-app agent</h4>
          <p class="text-sm text-base-content/75">
            A conversational agent capable of executing any action available within the product.
            Not just retrieving information, but operating on it. Built on tool-use, structured
            outputs, fine-grained permissions, and guardrails on every call.
          </p>
          <div class="flex flex-wrap gap-1 mt-2">
            <span class="badge badge-sm badge-ghost">LangChain</span>
            <span class="badge badge-sm badge-ghost">Tool use</span>
            <span class="badge badge-sm badge-ghost">Inngest</span>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 hover:border-info hover:-translate-y-0.5 transition-all">
        <div class="card-body">
          <div class="text-xs font-mono uppercase tracking-wider text-info mb-1">Infrastructure</div>
          <h4 class="font-bold text-lg">Production RAG pipelines</h4>
          <p class="text-sm text-base-content/75">
            Multiple production RAG systems covering clinical context for therapists, customer-support
            grounding, and internal knowledge. Built on vector search, deliberate chunking strategies,
            and eval-driven iteration.
          </p>
          <div class="flex flex-wrap gap-1 mt-2">
            <span class="badge badge-sm badge-ghost">Vector search</span>
            <span class="badge badge-sm badge-ghost">PostgreSQL</span>
            <span class="badge badge-sm badge-ghost">OpenAI / Gemini</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="mb-16">
    <h3 class="text-2xl font-bold mb-2">Selected products</h3>
    <p class="text-base-content/60 mb-6">Larger products I've built end-to-end.</p>

    <HorizontalCard
      title="Kindred Practice (formerly Mynd)"
      img="/projects/kindred-practice.png"
      desc="AI-powered practice management platform for therapists. Video sessions, automated note-taking with GPT and Gemini, RAG-based clinical chat, multi-agent workflows via LangChain and Inngest, scheduling, and billing."
      url="https://kindredpractice.com"
      badge="Live"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="Kindred Workplace"
      img="/projects/kindred-workplace.png"
      desc="Emotional-intelligence platform for teams. Currently the product engineer on Kindred Workplace, building full-stack systems, real-time features, and embedded AI."
      url="https://kindredworkplace.com"
      badge="Current"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="Medimap"
      img="/projects/medimap.png"
      desc="Healthcare platform helping patients find nearby walk-in clinics, urgent care centers, and other providers in real time."
      url="https://medimap.ca/"
    />
  </section>

  <!-- TECH STACK -->
  <section class="mb-16">
    <h3 class="text-2xl font-bold mb-4">Technologies</h3>
    <div class="flex flex-wrap gap-2">
      <span class="badge badge-lg">TypeScript</span>
      <span class="badge badge-lg">Python</span>
      <span class="badge badge-lg">Node.js</span>
      <span class="badge badge-lg">React</span>
      <span class="badge badge-lg">Django</span>
      <span class="badge badge-lg">FastAPI</span>
      <span class="badge badge-lg">PostgreSQL</span>
      <span class="badge badge-lg">AWS</span>
      <span class="badge badge-lg">LangChain</span>
      <span class="badge badge-lg">Inngest</span>
      <span class="badge badge-lg">Goose</span>
      <span class="badge badge-lg">RAG</span>
      <span class="badge badge-lg">Vector search</span>
      <span class="badge badge-lg">GPT &amp; Gemini</span>
      <span class="badge badge-lg">Deepgram</span>
      <span class="badge badge-lg">LiveKit</span>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="mb-12 text-center py-12 border-t border-base-300">
    <h3 class="text-3xl font-bold mb-3">Let's connect.</h3>
    <p class="text-base-content/70 mb-6 max-w-xl mx-auto">
      Open to conversations about AI engineering, agent systems, and product engineering at scale.
    </p>
    <a href="/contact" class="btn btn-primary btn-wide">Get in touch →</a>
  </section>
</BaseLayout>

<style>
  .fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fade-in-up { animation: none; opacity: 1; }
  }
</style>
