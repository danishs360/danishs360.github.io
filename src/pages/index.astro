---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import ProductPin from "../components/ProductPin.astro";
import ReelWall from "../components/ReelWall.astro";
import Wiring from "../components/Wiring.astro";
import { getCollection } from "astro:content";
import { baseResume } from "../data/resume";
import createSlug from "../lib/createSlug";
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from "../config";
import { person, website } from "../lib/schema";
import {
  tallyreel,
  roundZero,
  soonbuilt,
  kindredWorkplace,
  kindredPractice,
  kindredCore,
  agentOps,
  moreKindred,
  wirings,
} from "../data/work";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const tally = [
  { value: "8,300+", label: "people coached on Kindred Workplace" },
  { value: "200+", label: "therapists run their practice on Kindred Practice" },
  { value: "3", label: "products I launched on my own in 2026" },
  { value: "30+", label: "bugs and tickets fixed by my agents each month" },
];

const homeWirings = ["practice", "workplace", "core", "tallyreel", "roundzero", "agentops"].map(
  (id) => wirings.find((w) => w.id === id)!,
);

const profileSchema = {
  "@context": "https://schema.org",
  "@graph": [
    website,
    person,
    {
      "@type": "ProfilePage",
      "@id": `${SITE_URL}/#profile`,
      url: `${SITE_URL}/`,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      isPartOf: { "@id": `${SITE_URL}/#website` },
      mainEntity: { "@id": `${SITE_URL}/#person` },
      dateModified: new Date().toISOString(),
    },
  ],
};
---

<BaseLayout sideBarActiveItemID="home" wide baseSchema={false}>
  <JsonLd schema={profileSchema} />

  <!-- ═══ HERO: the wall ═══ -->
  <section class="intro" aria-labelledby="hero-h">
    <div class="hero-copy">
      <h1 id="hero-h">
        <span class="hand text-ember-ink text-[16px] -rotate-2 mb-4 inline-block font-medium tracking-normal">
          Danish Siddique · software &amp; product engineer in Islamabad
        </span>
        <span class="block display-title text-[clamp(44px,5.6vw,72px)] !tracking-[-0.04em] !leading-[1.02]">
          I build the product, and the AI <span class="hand text-ember !tracking-[-0.02em]">underneath it.</span>
        </span>
      </h1>
      <p class="mt-6 text-[clamp(18px,1.6vw,20px)] leading-normal text-ink-dim max-w-[31em]">
        Senior full-stack engineer. At Kindred I build Kindred Workplace and Kindred Practice, used by thousands
        of people and hundreds of therapists. On my own, through Soonbuilt, I've launched TallyReel and Round Zero.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3.5 mt-8">
        <a href="#kindred" class="btn-ember !h-14 !px-7 !text-[17px]">See what I've built</a>
        <a href="#wiring" class="textlink">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13.5 6.5L19 12l-5.5 5.5"></path></svg>
          <span>or see how it works</span>
        </a>
      </div>
      <p class="mt-5 text-[15px] text-ink-muted">
        Based in <a href="/software-engineer-islamabad/" class="text-ink-dim">Islamabad, Pakistan</a> · working remotely worldwide · open to senior full-stack and applied AI roles
      </p>
    </div>

    <div class="hero-wall" aria-label="What I've been working on">
      <p class="hand hw-arrow" aria-hidden="true">made on a laptop →</p>

      <a href="#tallyreel" class="note note-peach hw-live">
        <span class="tape" aria-hidden="true"></span>
        <span class="note-tag">Just shipped</span>
        <span class="note-idea">TallyReel: one line in, a finished video out</span>
        <span class="hw-go">See it <span aria-hidden="true">→</span></span>
      </a>

      <figure class="print hw-print">
        <span class="tape" aria-hidden="true"></span>
        <div class="print-frame">
          <video
            id="heroVideo"
            muted
            playsinline
            loop
            autoplay
            preload="metadata"
            poster="/media/tallyreel/ocean-depth.jpg"
            aria-label="A real video made by TallyReel from the line: How deep the ocean really is"
          >
            <source src="/media/tallyreel/ocean-depth.mp4" type="video/mp4" />
          </video>
          <button class="hw-sound" id="heroSound" type="button" aria-pressed="false" aria-label="Turn sound on">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path><path d="M15.5 9a4.5 4.5 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11"></path></svg>
          </button>
        </div>
        <figcaption>a real TallyReel render, unedited</figcaption>
      </figure>

      <a href="#kindred-workplace" class="note note-sky hw-2">
        <span class="tape" aria-hidden="true"></span>
        <span class="note-tag">Kindred Workplace</span>
        <span class="note-idea">EQ coaching for 8,300+ people</span>
      </a>
      <a href="#kindred-practice" class="note note-butter hw-3">
        <span class="note-tag">Kindred Practice</span>
        <span class="note-idea">200+ therapists, their notes written for them</span>
      </a>
      <a href="#round-zero" class="note note-mint hw-4">
        <span class="tape" aria-hidden="true"></span>
        <span class="note-tag">Live</span>
        <span class="note-idea">Round Zero: interviews with a voice AI</span>
      </a>
      <a href="#wiring" class="note note-lilac hw-5">
        <span class="note-tag">How it works</span>
        <span class="note-idea">See the wiring behind each one</span>
      </a>
      <a href="#reels" class="mini-print hw-mp" aria-label="Watch more TallyReel videos">
        <span class="print-frame"><img src="/media/tallyreel/pompeii.jpg" alt="" width="540" height="960" /></span>
      </a>
    </div>
  </section>

  <!-- the tally -->
  <section class="mt-10 sm:mt-4" aria-label="In numbers">
    <ul class="tally">
      {
        tally.map((t) => (
          <li>
            <b>{t.value}</b>
            <span>{t.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ═══ KINDRED ═══ -->
  <section class="block" id="kindred" aria-labelledby="kindred-h">
    <div class="head-left">
      <h2 id="kindred-h" class="display-title text-[clamp(32px,4.2vw,48px)]">At Kindred, since 2023</h2>
      <p class="mt-4 text-ink-dim text-lg">
        Kindred makes software that helps people understand each other: therapists and their clients, managers
        and their teams. These are the two products I've spent most of my time on.
      </p>
      <p class="hand head-aside" aria-hidden="true">my day job</p>
    </div>
    <div class="grid gap-20 sm:gap-24 mt-14">
      <ProductPin product={kindredWorkplace} />
      <ProductPin product={kindredPractice} flip />
    </div>

    <div class="mt-24">
      <h3 class="display-title text-[clamp(24px,2.8vw,32px)]">Underneath both products</h3>
      <p class="mt-3 text-ink-dim text-[17px] max-w-2xl">The shared AI and tooling I work on, so each product team moves faster.</p>
      <div class="grid md:grid-cols-2 gap-8 mt-10">
        {
          [kindredCore, agentOps].map((k, i) => (
            <article class={`note note-${k.tint} kin-note`} style={`--tilt:${i ? 1 : -1.2}deg`}>
              <span class="tape" aria-hidden="true" />
              <span class="note-tag">{k.kicker}</span>
              <h4 class="text-[24px] font-extrabold tracking-[-0.02em] leading-tight">{k.name}</h4>
              <p class="note-idea !text-[18px]">{k.line}</p>
              <p class="text-[15px] leading-relaxed text-[rgba(28,25,23,.78)]">{k.problem}</p>
              <ul class="kin-results">
                {k.results.map((r) => (
                  <li>
                    <b>{r.value}</b>
                    <span>{r.label}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <ul class="grid md:grid-cols-3 gap-4 mt-10 list-none p-0">
        {
          moreKindred.map((m) => (
            <li class="bento-card p-6">
              <h4 class="text-lg font-extrabold tracking-[-0.01em]">{m.name}</h4>
              <p class="mt-2 text-[15px] text-ink-dim leading-relaxed">{m.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══ SOONBUILT ═══ -->
  <section class="block" id="work" aria-labelledby="work-h">
    <div class="head-left">
      <h2 id="work-h" class="display-title text-[clamp(32px,4.2vw,48px)]">On my own: three products, all live</h2>
      <p class="mt-4 text-ink-dim text-lg">
        Built and run through Soonbuilt, my studio. Design, code, hosting, payments and the launch, start to finish.
      </p>
      <p class="hand head-aside" aria-hidden="true">nights and weekends</p>
    </div>
    <div class="grid gap-20 sm:gap-24 mt-14">
      <ProductPin product={tallyreel} />
      <ProductPin product={roundZero} flip />
      <ProductPin product={soonbuilt} />
    </div>
  </section>

  <!-- ═══ REELS ═══ -->
  <section class="block" id="reels" aria-labelledby="reels-h">
    <div class="head-left">
      <h2 id="reels-h" class="display-title text-[clamp(32px,4.2vw,48px)]">Every note here became a real video</h2>
      <p class="mt-4 text-ink-dim text-lg">
        Each idea was typed into TallyReel as one line and rendered on a laptop without a single edit. Peel a note
        to watch what it turned into, with sound.
      </p>
      <p class="hand head-aside" aria-hidden="true">go on, peel one</p>
    </div>
    <div class="mt-10">
      <ReelWall />
    </div>
  </section>

  <!-- ═══ WIRING ═══ -->
  <section class="block" id="wiring" aria-labelledby="wiring-h">
    <div class="head-left">
      <h2 id="wiring-h" class="display-title text-[clamp(32px,4.2vw,48px)]">How it works</h2>
      <p class="mt-4 text-ink-dim text-lg">
        The part a screenshot can't show: what happens between a person's first click and the result they get.
      </p>
      <p class="hand head-aside" aria-hidden="true">pick a note</p>
    </div>

    <div class="wire-tabs" role="tablist" aria-label="Products">
      {
        homeWirings.map((w, i) => (
          <button
            class={`note note-${["mint", "sky", "lilac", "peach", "mint", "butter"][i]} wire-tab`}
            role="tab"
            id={`tab-${w.id}`}
            aria-controls={`panel-${w.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            style={`--tilt:${[-2, 1.5, -1, 2, -1.5, 1][i]}deg`}
            type="button"
          >
            <span class="note-idea !text-[17px]">{w.tab}</span>
          </button>
        ))
      }
    </div>

    {
      homeWirings.map((w, i) => (
        <div role="tabpanel" id={`panel-${w.id}`} aria-labelledby={`tab-${w.id}`} hidden={i !== 0} class="wire-panel">
          <Wiring wiring={w} />
        </div>
      ))
    }
  </section>

  <!-- ═══ EXPERIENCE ═══ -->
  <section class="block" aria-labelledby="exp-h">
    <div class="grid lg:grid-cols-[4fr_8fr] gap-10 lg:gap-14 items-start">
      <div>
        <h2 id="exp-h" class="display-title text-[clamp(32px,4vw,46px)]">Where I've built</h2>
        <p class="mt-4 text-ink-dim">Five years of shipping, most of it with AI somewhere in the loop.</p>
        <a href="/resume/" class="textlink mt-6">Full resume →</a>
      </div>
      <ol class="sheet p-6 sm:p-8 list-none m-0">
        {
          baseResume.experience.map((job) => (
            <li class="exp">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-xl font-extrabold tracking-[-0.02em]">
                  {job.company}
                  {job.note && <span class="text-ink-muted text-base font-medium"> {job.note}</span>}
                </h3>
                <span class="text-sm text-ink-muted">{job.meta}</span>
              </div>
              <p class="hand text-ember-ink mt-1">{job.title}</p>
              <ul class="mt-3 space-y-1.5">
                {job.bullets.slice(0, 2).map((b) => (
                  <li class="text-[15px] text-ink-dim leading-relaxed" set:html={b} />
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══ WRITING ═══ -->
  {
    posts.length > 0 && (
      <section class="block" aria-labelledby="blog-h">
        <div class="flex items-end justify-between gap-4">
          <h2 id="blog-h" class="display-title text-[clamp(32px,4vw,46px)]">From the notebook</h2>
          <a href="/blog/" class="textlink hidden sm:inline-flex">All writing →</a>
        </div>
        <div class="grid md:grid-cols-3 gap-6 mt-10">
          {posts.map((post, i) => (
            <a
              href={"/blog/" + createSlug(post.data.title, post.slug)}
              class={`note note-${["white", "butter", "white"][i]} !p-6 !gap-3 no-underline`}
              style={`--tilt:${[-1, 1.2, -0.6][i]}deg`}
            >
              <time class="note-tag">
                {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </time>
              <h3 class="text-xl font-extrabold tracking-[-0.02em] leading-snug">{post.data.title}</h3>
              <p class="text-[15px] text-ink-dim line-clamp-3">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- ═══ CLOSE ═══ -->
  <section class="close" aria-labelledby="close-h">
    <div class="note note-butter note-close">
      <span class="tape" aria-hidden="true"></span>
      <h2 id="close-h" class="hand text-[clamp(32px,4.4vw,46px)] leading-tight">What should we build next?</h2>
      <p class="mt-3 text-lg text-[#5a4718]">
        Open to senior full-stack and applied AI roles, and to good conversations about agents, memory and
        on-device AI.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 mt-7">
        <a href="/contact/" class="btn-ember !h-14 !px-7 !text-[17px]">Get in touch</a>
        <a href="/resume/print?auto=1" target="_blank" class="textlink">Download my resume</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px;
    align-items: center;
  }
  .hero-wall {
    position: relative;
    height: 640px;
    width: 640px;
    justify-self: end;
  }
  .hero-wall > * {
    position: absolute;
  }
  .hero-wall .note {
    width: 196px;
    min-height: 150px;
    text-decoration: none;
  }
  .hw-live {
    left: 0;
    top: 44px;
    width: 224px !important;
    min-height: 196px !important;
    --tilt: -3deg;
    z-index: 3;
    outline: 3px solid #f06a1d;
    outline-offset: 5px;
  }
  .hw-go {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border: 1px solid rgba(28, 25, 23, 0.18);
    border-radius: 999px;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
  }
  .hw-arrow {
    left: 64px;
    top: -10px;
    color: #a93a0a;
    font-size: 18px;
    transform: rotate(-6deg);
  }
  .hw-print {
    left: 250px;
    top: 0;
    width: 214px;
    z-index: 2;
    transform: rotate(2deg);
  }
  .hw-print .print-frame {
    aspect-ratio: 9 / 16;
  }
  .hw-sound {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.94);
    cursor: pointer;
  }
  .hw-sound svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: #1c1917;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  .hw-sound[aria-pressed="true"] svg {
    stroke: #c7450c;
    opacity: 1;
  }
  .hw-2 {
    left: 480px;
    top: 26px;
    width: 170px !important;
    --tilt: 3deg;
  }
  .hw-3 {
    left: 12px;
    top: 318px;
    --tilt: 2.5deg;
    z-index: 2;
  }
  .hw-4 {
    left: 478px;
    top: 250px;
    width: 172px !important;
    --tilt: -2deg;
  }
  .hw-5 {
    left: 262px;
    top: 470px;
    --tilt: -3.5deg;
    z-index: 3;
  }
  .mini-print {
    width: 138px;
    z-index: 1;
    transition: transform 0.45s cubic-bezier(.16, 1, .3, 1);
  }
  .mini-print .print-frame {
    display: block;
    aspect-ratio: 9 / 16;
  }
  .hw-mp {
    left: 494px;
    top: 452px;
    transform: rotate(5deg);
  }
  .mini-print:hover {
    transform: rotate(0) translateY(-6px);
  }

  .tally {
    list-style: none;
    margin: 0;
    padding: 20px 8px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    border-top: 1px solid #ebe7e2;
    border-bottom: 1px solid #ebe7e2;
  }
  .tally li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tally b {
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .tally span {
    font-size: 14px;
    color: #6f6962;
  }

  .block {
    padding-top: 120px;
  }
  .head-left {
    position: relative;
    max-width: 660px;
  }
  .head-aside {
    position: absolute;
    right: -230px;
    bottom: 6px;
    color: #a93a0a;
    font-size: 19px;
    transform: rotate(-6deg);
  }

  .kin-note {
    padding: 26px 24px 24px;
    gap: 10px;
  }
  .kin-results {
    list-style: none;
    margin: 8px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid rgba(28, 25, 23, 0.12);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .kin-results li {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .kin-results b {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .kin-results span {
    font-size: 13px;
    line-height: 1.35;
    color: rgba(28, 25, 23, 0.7);
  }
  .wire-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 14px;
    margin: 40px 0 44px;
  }
  .wire-tab {
    width: auto;
    min-height: 0;
    padding: 12px 18px;
    border: 0;
    cursor: pointer;
    font: inherit;
    opacity: 0.72;
    border-radius: 4px 4px 4px 14px;
  }
  .wire-tab[aria-selected="true"] {
    opacity: 1;
    box-shadow: 0 0 0 3px #f06a1d, 0 1px 1px rgba(28, 25, 23, 0.06), 0 16px 26px -14px rgba(28, 25, 23, 0.32);
  }
  .wire-tab:hover {
    opacity: 1;
  }

  .exp + .exp {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #ebe7e2;
  }

  .close {
    padding: 130px 0 0;
    display: grid;
    place-items: center;
  }
  .note-close {
    width: min(640px, 100%);
    padding: 46px 40px 40px;
    align-items: center;
    text-align: center;
    --tilt: -1.5deg;
    gap: 0;
  }

  @media (max-width: 1100px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-wall {
      justify-self: center;
    }
  }
  @media (max-width: 960px) {
    .head-aside {
      position: static;
      display: inline-block;
      margin-top: 10px;
    }
  }
  @media (max-width: 700px) {
    .hero-wall {
      height: auto;
      width: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 26px 18px;
      padding-top: 14px;
    }
    .hero-wall > * {
      position: relative;
      left: auto;
      top: auto;
    }
    .hero-wall .note {
      width: auto !important;
      min-height: 0 !important;
    }
    .hw-live {
      grid-column: 1 / -1;
      width: min(420px, calc(100% - 20px)) !important;
      justify-self: center;
    }
    .hw-print {
      grid-column: 1 / -1;
      width: min(220px, 62%);
      justify-self: center;
    }
    .hw-arrow,
    .hw-mp {
      display: none;
    }
    .tally {
      grid-template-columns: 1fr 1fr;
    }
    .block {
      padding-top: 88px;
    }
    .note-close {
      padding: 36px 22px 28px;
    }
  }
</style>

<script>
  // hero sound toggle
  const video = document.getElementById("heroVideo") as HTMLVideoElement | null;
  const sound = document.getElementById("heroSound");
  if (video && sound) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) video.pause();
    sound.addEventListener("click", () => {
      const on = sound.getAttribute("aria-pressed") !== "true";
      video.muted = !on;
      if (on) video.play().catch(() => {});
      sound.setAttribute("aria-pressed", String(on));
      sound.setAttribute("aria-label", on ? "Turn sound off" : "Turn sound on");
    });
  }

  // wiring tabs
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".wire-tab")];
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
    });
    dispatchEvent(new Event("wiring:redraw"));
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(t));
    t.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!d) return;
      const next = tabs[(i + d + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>
