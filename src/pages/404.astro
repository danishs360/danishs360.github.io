---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 · Page Not Found" noindex>
  <div class="text-center py-20">
    <p class="section-label mb-4">404</p>
    <h1 class="display-title text-5xl mb-4">Page not found</h1>
    <p class="text-ink-dim mb-8">The page you're looking for doesn't exist or was moved.</p>
    <a href="/" class="btn-ember">Back home →</a>
  </div>
</BaseLayout>
