---
import CoverLetterDoc from "../../components/CoverLetterDoc.astro";
import { name } from "../../data/resume";
import type { Letter, CoverLetterMeta } from "../../data/coverLetter";

// Each file in src/data/cover-letters/*.ts exports `meta` and `letter`.
export function getStaticPaths() {
  const mods = import.meta.glob("../../data/cover-letters/*.ts", { eager: true });
  return Object.values(mods).map((mod: any) => ({
    params: { slug: mod.meta.slug as string },
    props: { letter: mod.letter as Letter, meta: mod.meta as CoverLetterMeta },
  }));
}

const { letter, meta } = Astro.props as { letter: Letter; meta: CoverLetterMeta };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{name} Cover Letter for {meta.company}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap"
    />
    <style is:inline>
      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        color: #111827;
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .toolbar {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .toolbar .tag {
        background: #0F2A4A;
        color: #fff;
        font-size: 11px;
        font-weight: 500;
        padding: 6px 10px;
        border-radius: 6px;
        opacity: 0.85;
      }
      .toolbar button,
      .toolbar a {
        background: #0F2A4A;
        color: white;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 14px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      }
      .toolbar a.secondary {
        background: white;
        color: #0F2A4A;
        border: 1px solid #D1D5DB;
      }
      .toolbar button:hover { background: #14365a; }

      .cover {
        max-width: 8.5in;
        margin: 32px auto;
        background: white;
        color: #111827;
        padding: 0.75in;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        border-radius: 4px;
      }

      @media print {
        @page { size: letter; margin: 0.75in; }
        html, body { background: white !important; }
        .toolbar { display: none !important; }
        .cover {
          margin: 0 !important;
          padding: 0 !important;
          box-shadow: none !important;
          border-radius: 0 !important;
          max-width: none !important;
          width: 100% !important;
        }
        a { color: inherit !important; text-decoration: none !important; }
        a[href]::after { content: "" !important; }
        *, *::before, *::after {
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
      }

      @media screen and (max-width: 600px) {
        .cover { margin: 16px; padding: 24px; }
        .toolbar { top: 10px; right: 10px; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <span class="tag">Tailored · {meta.company}</span>
      <a href="/cover-letter/tailored" class="secondary">← All letters</a>
      <button id="print-btn">Save as PDF</button>
    </div>

    <article class="cover">
      <CoverLetterDoc letter={letter} />
    </article>

    <script is:inline>
      document.getElementById("print-btn").addEventListener("click", () => window.print());
      if (new URLSearchParams(location.search).get("auto") === "1") {
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => setTimeout(() => window.print(), 200));
        } else {
          window.addEventListener("load", () => setTimeout(() => window.print(), 600));
        }
      }
    </script>
  </body>
</html>
