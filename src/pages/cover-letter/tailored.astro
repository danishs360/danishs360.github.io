---
import { name } from "../../data/resume";
import type { CoverLetterMeta } from "../../data/coverLetter";

const mods = import.meta.glob("../../data/cover-letters/*.ts", { eager: true });
const letters: CoverLetterMeta[] = Object.values(mods)
  .map((m: any) => m.meta as CoverLetterMeta)
  .sort((a, b) => (b.added ?? "").localeCompare(a.added ?? ""));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Tailored cover letters · {name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,600&display=swap"
    />
    <style is:inline>
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        color: #111827;
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 720px; margin: 48px auto; padding: 0 20px; }
      h1 {
        font-family: "Newsreader", ui-serif, Georgia, serif;
        font-size: 26px;
        color: #0F2A4A;
        margin: 0 0 4px 0;
      }
      .sub { color: #525252; font-size: 13px; margin: 0 0 24px 0; }
      .sub a { color: #0F2A4A; }
      .card {
        background: white;
        border: 1px solid #E5E5E5;
        border-radius: 8px;
        padding: 16px 18px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .card .company { font-weight: 600; font-size: 15px; color: #111827; }
      .card .role { font-size: 12.5px; color: #525252; margin-top: 2px; }
      .card .added { font-size: 11px; color: #9CA3AF; margin-top: 4px; }
      .actions { display: flex; gap: 8px; flex-shrink: 0; }
      .actions a {
        font-size: 13px;
        font-weight: 500;
        padding: 7px 12px;
        border-radius: 6px;
        text-decoration: none;
      }
      .actions a.view { background: white; color: #0F2A4A; border: 1px solid #D1D5DB; }
      .actions a.pdf { background: #0F2A4A; color: white; }
      .empty {
        background: white;
        border: 1px dashed #D1D5DB;
        border-radius: 8px;
        padding: 28px;
        text-align: center;
        color: #525252;
        font-size: 14px;
        line-height: 1.6;
      }
      .empty code {
        font-family: "JetBrains Mono", ui-monospace, Consolas, monospace;
        background: #F3F4F6;
        padding: 1px 5px;
        border-radius: 4px;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>Tailored cover letters</h1>
      <p class="sub">
        Job-specific letters built from the <a href="/cover-letter">base letter</a>. Private and
        noindexed. Open one and use Save as PDF to download.
      </p>

      {
        letters.length === 0 ? (
          <div class="empty">
            No cover letters yet.
            <br />
            Paste a job description into Claude and ask for a tailored cover letter. It'll add a file
            at <code>src/data/cover-letters/&lt;slug&gt;.ts</code> and it'll show up here.
          </div>
        ) : (
          letters.map((v) => (
            <div class="card">
              <div>
                <div class="company">{v.company}</div>
                <div class="role">{v.role}</div>
                {v.added && <div class="added">Added {v.added}</div>}
              </div>
              <div class="actions">
                <a class="view" href={`/cover-letter/${v.slug}`}>
                  View
                </a>
                <a class="pdf" href={`/cover-letter/${v.slug}?auto=1`} target="_blank">
                  Save as PDF
                </a>
              </div>
            </div>
          ))
        )
      }
    </div>
  </body>
</html>
