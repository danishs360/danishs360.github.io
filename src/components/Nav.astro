---
import { Image } from "astro:assets";

interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;

const links = [
  { id: "home", label: "Home", href: "/" },
  { id: "projects", label: "Work", href: "/projects" },
  { id: "blog", label: "Writing", href: "/blog/" },
  { id: "resume", label: "Resume", href: "/resume" },
  { id: "contact", label: "Contact", href: "/contact" },
];

const linkClass = (id: string) =>
  `nav-link ${activeId === id ? "nav-link-active" : ""}`;
---

<header class="fixed top-0 inset-x-0 z-40 px-4 pt-4">
  <nav
    class="glass max-w-6xl mx-auto rounded-2xl px-4 sm:px-6 h-14 flex items-center justify-between"
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div
        class="w-8 h-8 rounded-lg overflow-hidden ring-1 ring-ink-line group-hover:ring-ember/50 transition-all"
      >
        <Image
          src="/profile.webp"
          width={64}
          height={64}
          format="webp"
          alt=""
          class="w-full h-full object-cover"
        />
      </div>
      <span class="font-display text-lg hidden sm:block">Danish Siddique</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {
        links.map((l) => (
          <a href={l.href} class={linkClass(l.id)}>
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/danishs360"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost-line !px-3 !py-2 hidden sm:inline-flex"
        aria-label="GitHub"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
          ><path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path></svg
        >
      </a>
      <a href="/resume" class="btn-ember !text-sm !py-2 !px-4 hidden sm:inline-flex"> Hire me </a>

      <details class="md:hidden relative">
        <summary
          class="btn-ghost-line !px-3 !py-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
        </summary>
        <div
          class="absolute right-0 top-full mt-2 w-52 glass rounded-xl p-3 flex flex-col gap-1 shadow-2xl"
        >
          {
            links.map((l) => (
              <a href={l.href} class={`px-3 py-2.5 rounded-lg hover:bg-white/5 ${linkClass(l.id)}`}>
                {l.label}
              </a>
            ))
          }
          <hr class="border-ink-line my-1" />
          <a href="/resume" class="btn-ember !text-sm text-center !py-2">Hire me</a>
        </div>
      </details>
    </div>
  </nav>
</header>
