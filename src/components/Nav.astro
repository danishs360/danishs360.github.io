---
interface Props {
  activeId?: string;
}

const { activeId } = Astro.props;

const links = [
  { id: "projects", label: "Work", href: "/projects" },
  { id: "wiring", label: "How it's wired", href: "/#wiring" },
  { id: "blog", label: "Writing", href: "/blog/" },
  { id: "resume", label: "Resume", href: "/resume" },
  { id: "contact", label: "Contact", href: "/contact" },
];

const linkClass = (id: string) => `nav-link ${activeId === id ? "nav-link-active" : ""}`;
---

<header
  id="site-top"
  class="sticky top-0 z-40 bg-white/90 backdrop-blur-lg border-b border-transparent transition-colors print:hidden"
>
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-[68px] flex items-center gap-4" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5 no-underline text-ink-text mr-auto shrink-0" aria-label="Danish Siddique, home">
      <img src="/favicon.svg" width="32" height="32" alt="" class="w-8 h-8" />
      <span class="font-extrabold text-[19px] tracking-[-0.02em]">Danish Siddique</span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      {links.map((l) => <a href={l.href} class={linkClass(l.id)}>{l.label}</a>)}
    </div>

    <a href="/contact" class="btn-ember !h-[38px] !px-4 !text-sm hidden sm:inline-flex">Let's talk</a>

    <details class="md:hidden relative">
      <summary
        class="btn-ghost-line !h-[38px] !px-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
          ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"
          ></path></svg
        >
      </summary>
      <div class="absolute right-0 top-full mt-3 w-56 note note-butter !p-3 !gap-1" style="--tilt: 1.5deg">
        <span class="tape" aria-hidden="true"></span>
        {links.map((l) => <a href={l.href} class={linkClass(l.id)}>{l.label}</a>)}
        <a href="/contact" class="btn-ember !h-10 mt-2">Let's talk</a>
      </div>
    </details>
  </nav>
</header>

<script>
  const bar = document.getElementById("site-top");
  if (bar) {
    const mark = () => bar.classList.toggle("!border-ink-line", scrollY > 8);
    addEventListener("scroll", mark, { passive: true });
    mark();
  }
</script>
