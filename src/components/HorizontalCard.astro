---
const {
  title,
  img,
  desc,
  url,
  badge,
  tags,
  target = "_blank",
  variant = "row",
} = Astro.props;
import { Image } from "astro:assets";
const tag_url = url?.split("/").slice(0, -1).join("/") + "/tag";
const isHash = url === "#";
---

<article class="bento-card group">
  <a
    href={url}
    target={isHash ? undefined : target}
    class:list={[
      "block h-full",
      variant === "featured" ? "grid md:grid-cols-2 gap-0" : "flex flex-col sm:flex-row gap-0",
    ]}
  >
    {
      img && (
        <div
          class:list={[
            "relative overflow-hidden shrink-0",
            variant === "featured" ? "min-h-[220px] md:min-h-full" : "sm:w-48 md:w-56",
          ]}
        >
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="w-full h-full object-cover min-h-[160px] transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent md:bg-gradient-to-r" />
          {badge && (
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider bg-ember text-black font-semibold">
              {badge}
            </span>
          )}
        </div>
      )
    }
    <div class="p-5 sm:p-6 flex flex-col justify-center flex-1 relative">
      {!img && badge && (
        <span class="inline-block w-fit mb-2 px-2.5 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider bg-ember-dim text-ember border border-ember/30">
          {badge}
        </span>
      )}
      <h3 class="font-display text-xl sm:text-2xl text-ink-text group-hover:text-ember transition-colors">
        {title}
      </h3>
      <p class="mt-2 text-sm text-ink-dim leading-relaxed line-clamp-4">{desc}</p>
      {
        tags && (
          <div class="flex flex-wrap gap-1.5 mt-4">
            {tags.map((tag: string) => (
              <span class="tag-pill !text-[10px]">{tag}</span>
            ))}
          </div>
        )
      }
      {!isHash && (
        <span class="mt-4 text-xs font-mono text-ember opacity-0 group-hover:opacity-100 transition-opacity">
          View →
        </span>
      )}
    </div>
  </a>
</article>
