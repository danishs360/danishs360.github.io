    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-ember animate-pulse-slow"></span>
      <span>© {today.getFullYear()} Danish Siddique</span>
    </div>
    <div class="flex items-center gap-6 font-mono text-xs">
      <a href="https://github.com/danishs360" target="_blank" rel="noopener" class="hover:text-ember transition-colors">GitHub</a>
      <a href="https://linkedin.com/in/danishs360" target="_blank" rel="noopener" class="hover:text-ember transition-colors">LinkedIn</a>
      <a href="/rss.xml" class="hover:text-ember transition-colors">RSS</a>
    </div>
  </div>
</footer>
