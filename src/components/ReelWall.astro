---
// Real TallyReel renders, each hidden under the sticky note it was made from.
// Peel a note (click it) to play the video with sound.
import { reels } from "../data/work";

const tilts = [-3, 2.5, -1.5, 3, -2.5];
const drops = [0, 34, 8, 46, 14];
---

<ul class="reels">
  {
    reels.map((r, i) => (
      <li class="reel" style={`--pt:${tilts[i % 5]}deg; --dy:${drops[i % 5]}px`}>
        <div class="reel-print">
          <span class="tape" aria-hidden="true" />
          <div class="print-frame">
            <video
              playsinline
              preload="none"
              poster={`/media/tallyreel/${r.slug}.jpg`}
              aria-label={`TallyReel video made from the idea: ${r.idea}`}
            >
              <source src={`/media/tallyreel/${r.slug}.mp4`} type="video/mp4" />
            </video>
          </div>
          <button class={`note note-${r.tint} reel-note`} type="button" aria-label={`Peel the note and play: ${r.idea}`}>
            <span class="note-tag">{r.niche}</span>
            <span class="note-idea">{r.idea}</span>
          </button>
          <button class="reel-close" type="button">Stick it back</button>
        </div>
        <p class="reel-cap">
          {r.niche} · {r.dur}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .reels {
    list-style: none;
    margin: 0;
    padding: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 44px 26px;
  }
  .reel {
    width: 190px;
    margin-top: var(--dy, 0);
    transform: rotate(var(--pt, 0deg));
  }
  .reel-print {
    position: relative;
    aspect-ratio: 9 / 16;
  }
  .reel-print .print-frame {
    position: absolute;
    inset: 0;
  }
  .reel-note {
    position: absolute;
    left: -6px;
    right: -6px;
    top: -6px;
    height: 62%;
    z-index: 2;
    cursor: pointer;
    border: 0;
    font: inherit;
    transform-origin: 20% 0;
    transition: transform 0.6s cubic-bezier(.16, 1, .3, 1), opacity 0.5s;
  }
  .reel.open .reel-note {
    transform: translate(-8%, -36%) rotate(-14deg) scale(0.5);
    opacity: 0;
    pointer-events: none;
  }
  .reel-close {
    position: absolute;
    right: 8px;
    top: 8px;
    z-index: 3;
    display: none;
    height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    font: 600 13px/1 "Figtree", sans-serif;
    color: #1c1917;
    cursor: pointer;
  }
  .reel.open .reel-close {
    display: block;
  }
  .reel-cap {
    margin-top: 12px;
    font-size: 13.5px;
    color: #6f6962;
  }
  @media (max-width: 620px) {
    .reels {
      gap: 36px 14px;
    }
    .reel {
      width: calc(50% - 8px);
      margin-top: calc(var(--dy, 0px) / 2);
    }
    .reel-note .note-idea {
      font-size: 16px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".reel").forEach((reel) => {
    const video = reel.querySelector("video")!;
    const close = () => {
      reel.classList.remove("open");
      video.pause();
      video.removeAttribute("controls");
    };
    reel.querySelector(".reel-note")!.addEventListener("click", () => {
      document.querySelectorAll<HTMLElement>(".reel.open").forEach((r) => {
        if (r !== reel) r.querySelector<HTMLButtonElement>(".reel-close")!.click();
      });
      reel.classList.add("open");
      video.setAttribute("controls", "");
      video.play().catch(() => {});
    });
    reel.querySelector(".reel-close")!.addEventListener("click", close);
    video.addEventListener("ended", close);
  });
</script>
