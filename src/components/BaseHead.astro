---
import '../styles/global.css';
import { SITE_URL, SITE_AUTHOR, SITE_LOCALE, LOCATION } from '../config';
import { person, website, breadcrumbs } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** false on pages that print their own Person graph (the home page) */
  baseSchema?: boolean;
  /** breadcrumb label for inner pages */
  crumb?: string;
}

const {
  title,
  description,
  image = '/og.png',
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  baseSchema = true,
  crumb,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const ogImage = new URL(image, Astro.site ?? SITE_URL);
const rssUrl = new URL('/rss.xml', Astro.site ?? SITE_URL);
const graph = baseSchema
  ? {
      '@context': 'https://schema.org',
      '@graph': [website, person, ...(crumb ? [breadcrumbs(crumb, Astro.url.pathname)] : [])],
    }
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title={SITE_AUTHOR} href={rssUrl} />

<link rel="preload" href="/fonts/figtree-800.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/shantell-500.woff2" as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#ffffff" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap"
/>

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )
}
<meta name="geo.region" content={LOCATION.regionCode} />
<meta name="geo.placename" content={`${LOCATION.city}, ${LOCATION.country}`} />
<meta name="geo.position" content={`${LOCATION.lat};${LOCATION.lng}`} />
<meta name="ICBM" content={`${LOCATION.lat}, ${LOCATION.lng}`} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Danish Siddique, software and product engineer in Islamabad, Pakistan" />
<meta property="og:site_name" content={SITE_AUTHOR} />
<meta property="profile:first_name" content="Danish" />
<meta property="profile:last_name" content="Siddique" />
<meta property="og:locale" content={SITE_LOCALE} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
